<input type="input" v-model="datoscamposCuentas_cobrar.usuario" name="usuario"  class="form-control " id="usuarioAgregarDatos"  placeholder="usuario" maxlength="250">
</div>
<div class="form-group col-sm-12 mb-5 mt-5">
