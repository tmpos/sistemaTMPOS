<Dialog v-model:visible="visibleAbonosInteligentes" position="top" modal :style="{ width: '75rem' }" header="AbonosInteligente">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">AbonosInteligente</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">AbonosInteligente</legend>
    <div class="grid grid-cols-1  gap-4">
      <div>
<div class="overflow-x-auto border rounded-md p-4">
  <div v-html="generarTablaFromStringJSON(datosAbonosInteligentes, false, true,null,null,'tablaCxC',undefined)" class="min-w-full whitespace-nowrap"></div>
</div>
      </div>
    </div>
  </fieldset>

  <template #footer>
      <Button label="Excel" outlined severity="primary" icon="pi pi-file-excel" @click="fnCrearExcelAbonos"  />
      <Button label="Pdf" outlined severity="danger" icon="pi pi-file-pdf" @click="fnCrearPdfAbonos"  />
      <Button label="Cerrar" outlined severity="secondary" @click="visibleAbonosInteligentes = false"  />
  </template>
</Dialog>


