const fnReportePDF = () => {
  // Filtrar los datos según el cod_cliente
  const datosFact = data.value.filter(fact => fact.cod_cliente === clienteSeleccionadoCodigo.value);
  // Crear un nuevo documento PDF
  const doc = new jsPDF('p', 'mm', 'a4');

  // Definir las columnas de la tabla
  const columns = [
    { header: 'No_emision', dataKey: 'no_emision' },
    { header: 'No_factura', dataKey: 'no_factura' },
    { header: 'Fecha_emision', dataKey: 'fecha_emision' },
    { header: 'Monto_credito', dataKey: 'monto_credito' },
    { header: 'Abonado', dataKey: 'cuotas' },
    { header: 'Saldo', dataKey: 'saldo' },
    { header: 'Estatus', dataKey: 'estatus' }
  ];

  // Preparar los datos para la tabla
  const rows = [];
  datosFact.forEach(factura => {
    const { no_emision, no_factura, fecha_emision, monto_credito, cuotas, saldo, estatus, pagos } = factura;
    const pagosArray = JSON.parse(pagos);
    const pagosString = pagosArray.map(pago => `Nopago: ${pago.nopago}, Cantidad: ${pago.cantidad}, Metodo: ${pago.metodo}, Fecha: ${pago.fecha}, Hora: ${pago.hora}, Saldo: ${pago.saldo}`).join('\n');

    // Añadir la fila de la factura
    rows.push({
      no_emision,
      no_factura,
      fecha_emision,
      monto_credito,
      cuotas,
      saldo,
      estatus
    });

    // Añadir una fila adicional para los pagos
    rows.push({
      no_emision: '',
      no_factura: '',
      fecha_emision: '',
      monto_credito: '',
      cuotas: '',
      saldo: '',
      estatus: '',
      pagos: pagosString
    });
  });

  // Añadir la tabla al PDF
  doc.autoTable({
    head: [columns.map(col => col.header)],
    body: rows.map(row => {
      if (row.pagos) {
        return [{ content: row.pagos, colSpan: columns.length, styles: { halign: 'left' } }];
      }
      return columns.map(col => row[col.dataKey]);
    }),
    startY: 20,
    styles: {
      fontSize: 10,
      cellPadding: 5,
      overflow: 'linebreak',
      cellWidth: 'wrap'
    },
    headStyles: {
      fillColor: [255, 255, 255],
      textColor: [0, 0, 0],
      fontStyle: 'bold'
    },
    bodyStyles: {
      fillColor: [255, 255, 255],
      textColor: [0, 0, 0]
    },
    columnStyles: {
      0: { cellWidth: 25 },
      1: { cellWidth: 25 },
      2: { cellWidth: 25 },
      3: { cellWidth: 25 },
      4: { cellWidth: 25 },
      5: { cellWidth: 25 },
      6: { cellWidth: 25 }
    },
    didDrawPage: function (data) {
      // Añadir el encabezado de la página
      doc.setFontSize(20);
      doc.setTextColor(40);
      doc.text('Reporte de Cuentas por Cobrar', data.settings.margin.left, 15);
    },
    margin: { top: 40 },
    rowPageBreak: 'auto', // Permitir que las filas se rompan en múltiples páginas si es necesario
    theme: 'grid' // Añadir líneas de cuadrícula para mejorar la legibilidad
  });

  // Guardar el PDF
  const clienteNombre = datosFact.length > 0 ? datosFact[0].nombre_cliente : 'Desconocido';
  doc.save(`Reporte_Cuentas_cobrar_${clienteNombre}.pdf`);
};

const fnReporteEXCEL = () => {
  // Filtrar los datos según el cod_cliente
  const datosFact = data.value.filter(fact => fact.cod_cliente === clienteSeleccionadoCodigo.value);

  // Crear un nuevo libro de trabajo
  const wb = XLSX.utils.book_new();

  // Definir las columnas de la tabla
  const columns = [
    'No_emision',
    'No_factura',
    'Fecha_emision',
    'Monto_credito',
    'Abonado',
    'Saldo',
    'Estatus',
    'Pagos'
  ];

  // Preparar los datos para la tabla
  const rows = [];
  datosFact.forEach(factura => {
    const { no_emision, no_factura, fecha_emision, monto_credito, cuotas, saldo, estatus, pagos } = factura;
    const pagosArray = JSON.parse(pagos);
    const pagosString = pagosArray.map(pago => `Nopago: ${pago.nopago}, Cantidad: ${pago.cantidad}, Metodo: ${pago.metodo}, Fecha: ${pago.fecha}, Hora: ${pago.hora}, Saldo: ${pago.saldo}`).join('\n');

    // Añadir la fila de la factura
    rows.push([
      no_emision,
      no_factura,
      fecha_emision,
      monto_credito,
      cuotas,
      saldo,
      estatus,
      pagosString
    ]);
  });

  // Crear una hoja de cálculo
  const ws = XLSX.utils.aoa_to_sheet([columns, ...rows]);

  // Añadir la hoja de cálculo al libro de trabajo
  XLSX.utils.book_append_sheet(wb, ws, 'Reporte de Cuentas por Cobrar');

  // Generar el archivo Excel
  const clienteNombre = datosFact.length > 0 ? datosFact[0].nombre_cliente : 'Desconocido';
  XLSX.writeFile(wb, `Reporte_Cuentas_cobrar_${clienteNombre}.xlsx`);
};
