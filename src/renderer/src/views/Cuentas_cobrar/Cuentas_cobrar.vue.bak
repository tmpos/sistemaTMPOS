};
/************************************************************************/
const fetchClientes = async () => {
    const response = await peticionesFetchOffline('getDataAsArray', 'clientes');
    const jsonData = response;
    
    // Filtramos los clientes cuyo nombre no esté vacío y luego mapeamos para obtener solo los nombres
    const filteredClientes = jsonData.filter(cliente => cliente.nombre && cliente.nombre.trim() !== '');
    
    // Asignamos los clientes filtrados al array
    clientesArray.value = filteredClientes;
    //clientesArrayNombre.value = filteredClientes.map(cliente => cliente.nombre);
};

