</template>
<style >
.row-red {
  color: red !important;
}

.row-green {
  color: green !important;
}

.row-yellow {
  color: yellow !important;
}

/* Estado: Pendiente - Blanco en modo claro, gris claro en modo oscuro */
.pendiente {
  color: #FFFFFF !important; /* Blanco */
}

/* Estado: Devolución - Rojo */
.devolucion {
  color: #DC3545 !important; /* Rojo */
}

/* Estado: Reparado - Azul para diferenciarlo */
.reparado {
  color: #007BFF !important; /* Azul */
}

/* Estado: Entregado - Verde */
.entregado {
  color: #28A745 !important; /* Verde */
}

/* Estado: Revisión - Amarillo */
.revision {
  color: #FFC107 !important; /* Amarillo */
}

/* Modo oscuro: Pendiente en gris claro */
@media (prefers-color-scheme: dark) {
  .pendiente {
    color: #DDDDDD !important; /* Gris claro */
  }
}

</style>