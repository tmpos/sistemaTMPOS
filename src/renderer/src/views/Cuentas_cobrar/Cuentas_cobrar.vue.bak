<template>
<main class="content-wrapper">
  <div class="container-fluid mt-5">
<Card>
<template #content>
    <div class="row">
      <div class="col-md-12">
        <fieldset class="border p-3 rounded mb-2">
          <legend class="float-none w-auto px-2">Datos de Cuentas_cobrar</legend>
            <div class="row">
              <div class="col-sm-12">
                <a href="#" @click="fetchAndSetupData" class="btn btn-warning text-white cartelito" data-toggle="tooltip" title="Recargar" id="reload"><i class="icon-arrows-cw"></i></a>
<router-link to="/vender" class="btn btn-success text-white ms-1"><i class="icon-plus"></i></router-link>
               <a href="#" @click="borrarSeleccionados" class="btn btn-danger btnaccion cartelito ms-1" data-toggle="tooltip" title="Borrar Selección" id="borrador"><i class="icon-trash-4"></i></a>
<a href="#" v-if="usuarioLocal.usuario =='Soporte'"  @click="borrarTodo" class="btn btn-danger btnaccion cartelito float-end ms-1" data-toggle="tooltip" title="Borrar Todo" id="borrartodo"><i class="icon-trash"></i> Borrar Todo</a>

<a href="#"  @click="fnExportarExcel" class="btn btn-success btnaccion cartelito  ms-1" data-toggle="tooltip" title="Excel" id="excel"><i class="pi pi-file-excel"></i> Excel</a>

<a href="#" v-if="fechaInteligente"  @click="fnAbonosFechaInteligente" class="btn btn-dark btnaccion cartelito  ms-1"  id="excel"><i class="pi pi-money-bill"></i> Ver Abonos</a>


              </div>

              <div class="col-12 col-sm-6 col-md-4 col-lg-3">
              <label for="email_cliente-Actualizador">FILTRAR POR ESTADO</label>
              <Dropdown  v-model="estadoFiltro" :options="['TODOS','PENDIENTE','SALDADO']" placeholder="Seleccione estatus" class="w-full" />
              </div>
              <div class="col-12 col-sm-6 col-md-4 col-lg-3">
              <label for="porfecha">FILTRAR POR FECHA</label>
                    <Calendar v-model="filtrarPorFecha" fluid name="porfecha" dateFormat="dd/mm/yy"  />
              </div>

              <div class="col-12 col-sm-12 col-md-4 col-lg-3">
              <label for="porfecha">BUSCAR CLIENTE</label>
                 <awesomplete
                    class="dropdown-input"
                    v-model="clienteSeleccionado"
                    @change="fnAwesomplete"
                    @selectComplete="handleSelectComplete"
                    :list="clientesArrayNombre">
            </awesomplete>

              </div>

              <div class="col-12 col-sm-12 col-md-12 col-lg-3">
             <label for="porfecha">BUSCADOR INTELIGENTE</label>

<InputGroup>
    <DatePicker dateFormat="dd/mm/yy" selectionMode="range" :showButtonBar="true" @value-change="fechaInteligenteSeleccionada" v-model="buscadorFechaInteligente" />
<!--      <flat-pickr v-model="buscadorFechaInteligente" @on-change="fechaInteligenteSeleccionada"  class="form-input w-full" :config="basic"></flat-pickr> -->
    <InputGroupAddon>
        <Button icon="pi pi-search" severity="secondary" variant="text" @click="toggleInteligente" />
    </InputGroupAddon>
</InputGroup>
 <Menu ref="menuInteligente" :model="itemsInteligente" popup class="!min-w-fit" />
              </div>


            </div>
        </fieldset>
      </div>
      <div class="col-md-12">
 <div style="display: flex; justify-content: flex-end;">
 <input v-model="searchQuery" placeholder="Buscar cuentas_cobrar..." class="p-inputtext p-component" style="margin-bottom: 10px;" />
</div>
<DataTable 
    :value="filteredCuentas_cobrar"  
    scrollable 
    scrollHeight="600px"  
    dataKey="id" 
    paginator 
    :rows="10" 
    @rowSelect="onRowSelect" 
    selectionMode="single" 
    size="small"
    resizableColumns 
    columnResizeMode="fit"
    :rowClass="getRowClass"
    :rowsPerPageOptions="[5, 10, 20, 50]" 
    tableStyle="min-width: 50rem">
    <Column header="Options">
        <template #body="slotProps">
            <Button 
                icon="pi pi-cog" 
                @click="toggleCuentas_cobrar($event, slotProps.data)"
                aria-haspopup="true"
                aria-controls="overlay_menu_factura"
            />
            <Menu 
                ref="menu" 
                id="overlay_menu_Cuentas_cobrar" 
                :model="itemsCuentas_cobrar" 
                :popup="true"
            />
        </template>
    </Column>
    <Column field="id" header="ID"></Column>
<Column field="tipocredito" header="Tipo Credito">
            <template #body="slotProps">
            <Badge :value="slotProps.data.tipocredito" :severity="colorEstado(slotProps.data)" />
        </template>
</Column>
    <Column field="no_emision" header="No_emision"></Column>
<Column field="no_factura" header="No_factura"></Column>
<Column field="cod_cliente" header="Cod_cliente"></Column>
<Column field="nombre_cliente" header="Nombre_cliente"></Column>
<Column field="cedula_cliente" header="Cedula_cliente"></Column>
<Column field="telefono_cliente" header="Telefono_cliente"></Column>
<!-- <Column field="whatsapp_cliente" header="Whatsapp_cliente"></Column>
<Column field="email_cliente" header="Email_cliente"></Column>
<Column field="direccion_cliente" header="Direccion_cliente"></Column>
<Column field="rnc_cliente" header="Rnc_cliente"></Column>
<Column field="nombrecomercial_cliente" header="Nombrecomercial_cliente"></Column> -->
<!-- <Column field="saldo" header="Saldo"></Column> -->

<Column field="saldo" header="Saldo">
    <template #body="slotProps">
            <Badge :value="slotProps.data.saldo" severity="secondary" />
    </template>
</Column>
<Column field="fecha_emision" header="Fecha_emision"></Column>
<Column field="monto_credito" header="Monto_credito"></Column>
<Column field="interes" header="Interes"></Column>
<Column field="fecha_vencimiento" header="Fecha_vencimiento"></Column>
<Column field="cuotas" header="Cuotas"></Column>
<Column field="fecha_pago" header="Fecha_pago"></Column>
<Column field="estatus" header="Estatus"></Column>
<Column field="hora" header="Hora"></Column>
<Column field="vendedor" header="Vendedor"></Column>
<Column field="delivery" header="Delivery"></Column>

</DataTable>
      </div>
    </div>
  </template>
</Card>
<Toast />
  </div>
</main>


<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->

<Dialog v-model:visible="visibleDatosCliente" modal :position="position" header="Imprimir Factura" :style="{ width: '40rem' }">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Datos del Cliente</span>
    </div>
  </template>

      <fieldset class="border p-3 rounded mb-2">
        <legend class="float-none w-auto px-2">{{clienteSeleccionadoModal}}</legend>
          <div class="row">
            <div class="col-12">
              <h3>Total Adeudado: {{totaAdeudado}}</h3>
              <h5>Total de Facturas Pendientes: {{cantidadFacturas}}</h5>
            </div>

          </div>
      </fieldset>

  <template #footer>
    <Button label="Saldo" outlined severity="secondary" @click="imprimirSaldo"  />
    <Button label="Reporte" outlined severity="secondary" @click="visiblePrint = true"  />
    <Button label="Imprimir" outlined severity="secondary" @click="visiblePrint01 = true"  />
    <Button label="Abonar" outlined severity="secondary" @click="visibleAbonoModal = true"  />
    <Button label="Pagar Todo" outlined severity="secondary" @click="fnPagarTodo"  />
    <Button label="Cancel" outlined severity="secondary" @click="visibleDatosCliente = false" autofocus />
  </template>
</Dialog>
<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
  <Dialog v-model:visible="visiblePrint01" :position="position" modal header="Productos" :style="{ width: '30rem' }" :breakpoints="{ '1199px': '75vw', '575px': '90vw' }">
    <template #header>
      <div class="inline-flex align-items-center justify-content-center gap-2">
        <span class="font-bold white-space-nowrap">Modal Editar</span>
      </div>
    </template>

    <fieldset class="border p-3 rounded mb-2">
      <legend class="float-none w-auto px-2">Elige la Impresora</legend>
      <div class="flex flex-wrap gap-4 justify-center">
         <Button label="Impresora Grande" icon="pi pi-print" @click="fnImpresoraGrande00" iconPos="bottom" />
         <Button label="Impresora Térmica" icon="pi pi-print" @click="fnImpresoraChica00" iconPos="bottom" />
     </div >
    </fieldset>

    <template #footer>
      <Button label="Cancel" text severity="secondary" @click="visiblePrint01 = false" />
    </template>
  </Dialog>
<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visibleAbono" modal :position="position" header="Modal de Abono" :style="{ width: '40rem' }">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Modal de Abono</span>
    </div>
  </template>

      <fieldset class="border p-3 rounded mb-2">
        <legend class="float-none w-auto px-2">{{clienteSeleccionadoModal}}</legend>
          <div class="row">
                <div class="col-12">
                  <Button :label="btn1Abono" outlined severity="secondary" @click="fnbtnAgregArbono(btn1Abono)"  />
                  <Button :label="btn2Abono" class="mx-1" outlined severity="secondary" @click="fnbtnAgregArbono(btn2Abono)"  />
                  <Button :label="btn3Abono" outlined severity="secondary" @click="fnbtnAgregArbono(btn3Abono)"  />
                </div>

                  <div class="col-4 form-group">
                    <label for="fechaabono">FECHA</label>
                    <InputText type="text" name="fechaabono" v-datepicker v-model="fechaAbonoModal"  class="form-control datepicker " id="fechaabono"  />
                  </div>



                  <div class="col-4 form-group">
                    <label for="abono">ABONO </label>
                    <InputText  name="abono" v-model="abonoAbonoModal" v-solonumeros v-decimales  class="form-control" id="abono"  />
                  </div>

                  <div class="col-4 form-group">
                    <label for="metodoabono">METODO</label>
                  <Dropdown  v-model="metodoAbonoModal" :options="['EFECTIVO','TRANSFERENCIA','TARJETA']" placeholder="Seleccione estatus" class="w-full" />
                  </div>
          </div>
      </fieldset>

  <template #footer>
    <Button label="Agregar Abono" outlined severity="secondary" @click="fnAgregarAbono"  />
    <Button label="Cancel" outlined severity="secondary" @click="visibleAbono = false" autofocus />
  </template>
</Dialog>
<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visibleAbonoModal" modal :position="position" header="Modal de Abono" :style="{ width: '40rem' }">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Modal de Abono</span>
    </div>
  </template>

      <fieldset class="border p-3 rounded mb-2">
        <legend class="float-none w-auto px-2">{{clienteSeleccionadoModal}}</legend>
          <div class="row">
                <div class="col-12">
                  <Button :label="btn1Abono" outlined severity="secondary" @click="fnbtnAgregArbono(btn1Abono)"  />
                  <Button :label="btn2Abono" class="mx-1" outlined severity="secondary" @click="fnbtnAgregArbono(btn2Abono)"  />
                  <Button :label="btn3Abono" outlined severity="secondary" @click="fnbtnAgregArbono(btn3Abono)"  />
                </div>

                  <div class="col-4 form-group">
                    <label for="fechaabono">FECHA</label>
                    <InputText type="text" name="fechaabono" v-datepicker v-model="fechaAbonoModal"  class="form-control datepicker " id="fechaabono" />
                  </div>



                  <div class="col-4 form-group">
                    <label for="abono">ABONO</label>
                    <InputText name="abono" v-model="abonoAbonoModal" v-solonumeros v-numeroFocusinOut v-decimales  class="form-control decimales soloNumero" id="abono"  />
                  </div>

                  <div class="col-4 form-group">
                    <label for="metodoabono">METODO</label>
                  <Dropdown  v-model="metodoAbonoModal" :options="['EFECTIVO','TRANSFERENCIA','TARJETA']" placeholder="Seleccione estatus" class="w-full" />
                  </div>
          </div>
      </fieldset>

  <template #footer>
    <Button label="Agregar Abono" outlined severity="secondary" @click="fnAgregarAbonoModal"  />
    <Button label="Cancel" outlined severity="secondary" @click="visibleAbonoModal = false" autofocus />
  </template>
</Dialog>
<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
  <Dialog v-model:visible="visiblePrint" :position="position" modal header="Productos" :style="{ width: '50rem' }" :breakpoints="{ '1199px': '75vw', '575px': '90vw' }">
    <template #header>
      <div class="inline-flex align-items-center justify-content-center gap-2">
        <span class="font-bold white-space-nowrap">Modal Editar</span>
      </div>
    </template>

    <fieldset class="border p-3 rounded mb-2">
      <legend class="float-none w-auto px-2">Elige una Opción</legend>
      <div class="flex flex-wrap gap-4 justify-center">
         <Button label="Ver Detalles" icon="pi pi-eye" @click="fnVerDetalles" iconPos="bottom" />
         <Button label="Impresora" icon="pi pi-print" @click="fnImpresoraGrande" iconPos="bottom" />
         <Button label="Térmica" icon="pi pi-print" @click="imprimirFactura" iconPos="bottom" />
         <Button label="PDF" icon="pi pi-arrow-circle-down" @click="fnReportePDF" iconPos="bottom" />
         <Button label="EXCEL" icon="pi pi-arrow-circle-down" @click="fnReporteEXCEL" iconPos="bottom" />
     </div >
