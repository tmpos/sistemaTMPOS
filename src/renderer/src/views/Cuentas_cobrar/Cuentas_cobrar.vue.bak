const colorEstado = (data) => {

    if (data.tipocredito === 'NORMAL') {
        return 'success'; // Suficiente stock
    } else if (data.tipocredito === 'CUOTAS') {
        return 'warn'; // Stock bajo
    }  else {
        return 'secondary'; // Por si acaso
    }
};
