onMounted(async() => {
const datosJSON = await envioElectron('datosarchivo');
link.value = datosJSON.VITE_LINKURL;
api.value = datosJSON.VITE_LINK_API;
token.value = datosJSON.VITE_TOKEN;
patronTelefono.value = datosJSON.VITE_PATRON_TELEFONO;
linkImpresora.value = datosJSON.VITE_IMPRESORA_LOCAL;
patroncedula.value = datosJSON.VITE_PATRON_CEDULA;
tokenCorto.value = datosJSON.VITE_TOKEN_CORTO;
tokenCifrado.value = await encryptarPassword(token.value, 10);

datosConfiguracion.value = JSON.parse(window.localStorage.getItem('configuracion'))

await fetchAndSetupData()
await fetchProveedores()
await fetchCategorias()
await fetchProductos()
datosCajero.value = await cajeroACtivo(link.value+api.value)
categoria.value = categoriasNombres.value[0]

});
/************************************************************************/
const agregarLosProductos = async () => {
  try {
    const datosIMEI = await arrayToObjetoFromTabla(link.value + api.value, tokenCifrado.value, 'imei');
    const productosArray = JSON.parse(datoscamposCompras.value.productos);

    const baseURL = `${link.value}${api.value}`;
    const urlInsertarProducto = `${baseURL}/insertar/productos`;
    const urlActualizarProducto = `${baseURL}/actualizarcampos/productos`;
    const urlInsertarIMEI = `${baseURL}/insertar/imei`;

    // Función para procesar un producto
    const procesarProducto = async (producto) => {
      try {
        const verificaExistenciaProducto = await peticionesFetch(
          `${baseURL}`,
          `datoscampo/productos/codigo/${producto.codigo}`,
          {},
          tokenCifrado.value,
          'GET'
        );

        if (verificaExistenciaProducto) {
          // Producto ya existe, actualizar stock
          verificaExistenciaProducto.no_compra = producto.no_compra;
          if (verificaExistenciaProducto.categoria === 'CELULARES') {
            const response = await enviarDatosPorPost(
              `${baseURL}/datosarraydoblecondicion/imei`,
              { campo1: 'id_equi', valor1: verificaExistenciaProducto.id, campo2: 'estado', valor2: 'DISPONIBLE' },
              tokenCifrado.value
            );
            verificaExistenciaProducto.stock = response.length;
          } else {
            verificaExistenciaProducto.stock = Number(verificaExistenciaProducto.stock) + Number(producto.stock);
          }

          await enviarDatosPorPost(urlActualizarProducto, verificaExistenciaProducto, tokenCifrado.value);
        } else {
          // Producto no existe, insertar nuevo producto
          producto.almacen = datosEmpresa.empresa.nombre
          const envioDatos = await enviarDatosPorPost(urlInsertarProducto, producto, tokenCifrado.value);

          // Si es categoría CELULARES, insertar IMEIs asociados
          if (envioDatos[0] === 'ok' && producto.categoria === 'CELULARES' && producto.otro) {
            await agregarIMEIs(urlInsertarIMEI, producto, datosIMEI);
          }
        }
      } catch (productoError) {
        console.error(`Error al procesar el producto con código ${producto.codigo}:`, productoError);
      }
    };

    // Procesar cada producto en paralelo con limitación de concurrencia
    const maxConcurrentRequests = 5; // Ajusta este valor según sea necesario
    const promisesProductos = [];

    for (let i = 0; i < productosArray.length; i += maxConcurrentRequests) {
      const batch = productosArray.slice(i, i + maxConcurrentRequests);
      const batchPromises = batch.map(procesarProducto);
      await Promise.all(batchPromises);
    }

    console.log('Todos los productos y sus IMEIs han sido agregados correctamente.');
  } catch (error) {
    console.error('Error al agregar productos e IMEIs:', error);
    toast.add({ severity: 'error', summary: 'Error', detail: 'No se pudo completar la operación.', life: 3000 });
  }
};


// Función auxiliar para agregar IMEIs
const agregarIMEIs = async (urlInsertarIMEI, producto, datosIMEI) => {
  try {
    const datosImei = await peticionesFetch(
      `${link.value}${api.value}`,
      `datoscampo/productos/codigo/${producto.codigo}`,
      {},
      tokenCifrado.value,
      'GET'
    );

    if (datosImei) {
      const listImei = producto.otro.split(',').map((imei) => imei.trim()).filter((imei) => imei);

      const promisesIMEI = listImei.map(async (imei) => {
        const nuevoIMEI = {
          ...datosIMEI,
          imei,
          estado: 'DISPONIBLE',
          fecha: nfecha('fecha'),
          equipo: producto.nombre,
          proveedor: producto.proveedor,
          id_equi: datosImei.id,
          costo: producto.precio_compra,
          precio_venta: producto.precio_venta,
          no_compra: producto.no_compra,
          fecha_venta: '',
          hora_venta: '',
          comprador: '',
          detalles: '',
          usuario: '',
        };
        return enviarDatosPorPost(urlInsertarIMEI, nuevoIMEI, tokenCifrado.value);
      });

      await Promise.all(promisesIMEI);
    }
  } catch (imeiError) {
    console.error(`Error al agregar IMEIs para el producto ${producto.nombre}:`, imeiError);
  }
};

/************************************************************************/
async function enviarDatos(event) {
    event.preventDefault();
  const url = link.value+api.value+"/insertar/compras";
  if (!datoscamposCompras.value) {
    toast.add({ severity: 'error', summary: 'Error', detail: 'Datos incompletos, no se puede Enviar.', life: 3000 });
    return;
  }
  if (datoscamposCompras.value.hasOwnProperty('created_at')) {
     datoscamposCompras.value.created_at = nfecha('timestamp')
     datoscamposCompras.value.updated_at = nfecha('timestamp')
    }
  const envioDatos = await enviarDatosPorPost(url, datoscamposCompras.value,tokenCifrado.value);
  if (envioDatos[0] == 'ok') {
     toast.add({ severity: 'success', summary: 'Éxito', detail: 'Datos Agregados con éxito.', life: 3000 });


  if (datoscamposCompras.value.estado === 'PENDIENTE') {
    const jsonDataPagar = await arrayToObjetoFromTabla(link.value+api.value,tokenCifrado.value,'cuentasxpagar');
    
      const ultimaFactura = await peticiones(`${link.value}${api.value}/datosmax`, {"tabla":'cuentasxpagar',"campo":'no_emision'},'POST',tokenCifrado.value);

    jsonDataPagar.no_emision = generadorCodigo(ultimaFactura[0], 'CXP', 7);


    jsonDataPagar.proveedor = datoscamposCompras.value.proveedor
    jsonDataPagar.rnc = datoscamposCompras.value.rnc_proveedor
    jsonDataPagar.estado = datoscamposCompras.value.estado

    jsonDataPagar.fecha = nfecha('fecha')
    jsonDataPagar.hora = nfecha('hora')
    jsonDataPagar.productos = datoscamposCompras.value.productos
    jsonDataPagar.total = datoscamposCompras.value.total
    jsonDataPagar.subtotal = datoscamposCompras.value.subtotal
    jsonDataPagar.saldo = datoscamposCompras.value.saldo
    jsonDataPagar.abono = datoscamposCompras.value.abono
    jsonDataPagar.impuestos = datoscamposCompras.value.impuesto
    jsonDataPagar.nota = datoscamposCompras.value.nota
    jsonDataPagar.no_factura = datoscamposCompras.value.no_factura


   const npago = [{
    "nopago": 1,
    "cantidad": datoscamposCompras.value.abono,
    "metodo": 'EFECTIVO',
    "fecha": nfecha('fecha'),
    "hora": nfecha('hora'),
    "turno":datosCajero.value.turno,
    "cajero":datosCajero.value.username,
    "saldo": datoscamposCompras.value.saldo
  }];

  jsonDataPagar.pagos = JSON.stringify(npago);

  const urlPAGAR = link.value+api.value+"/insertar/cuentasxpagar";
  if (!jsonDataPagar) {
    toast.add({ severity: 'error', summary: 'Error', detail: 'Datos incompletos, no se puede Enviar.', life: 3000 });
    return;
  }
  if (jsonDataPagar.hasOwnProperty('created_at')) {
     jsonDataPagar.created_at = nfecha('timestamp')
     jsonDataPagar.updated_at = nfecha('timestamp')
    }
  const envioDatos = await enviarDatosPorPost(urlPAGAR, jsonDataPagar,tokenCifrado.value);
  

  }

await agregarLosProductos();


Swal.fire({
  title: "Datos Agregados",
  text: "Que hacemos ahora?",
  icon: "warning",
  showCancelButton: true,
  confirmButtonText: "Agregar Otro!",
  cancelButtonText: "No, Regresar al Inicio!",
 }).then(async(result) => {
  if (result.isConfirmed) {
      fetchAndSetupData()
} else if (result.dismiss === Swal.DismissReason.cancel) {
    router.push({ path: `/compras` });
  }
})
  }else{
    toast.add({ severity: 'error', summary: 'Error', detail: 'Fallo al Agregar los datos.', life: 3000 });
  }
}
