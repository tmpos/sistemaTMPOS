/************************************************************************/
const calcularPrecios = () => {
  // Convertir los valores a números
  const precioCompra = parseFloat(productoPrecio.value) || 0;
  const ganancia = parseFloat(productoGanancia.value) || 0;
  const impuesto = parseFloat(productoImpuesto.value) || 0;

  // Calcular la ganancia en base al porcentaje de ganancia
  const gananciaCalculada = precioCompra * (ganancia / 100);

  // Calcular el precio base de venta antes de impuesto
  let precioVenta = precioCompra + gananciaCalculada;
  let precioVentaSolo = precioCompra + gananciaCalculada;

  // Si hay impuesto, aplicarlo sobre el precio base de venta
  if (impuesto > 0) {
    const impuestoCalculado = precioVenta * (impuesto / 100);
    precioVenta += impuestoCalculado;
    productoImpuestoVenta.value = impuestoCalculado.toFixed(2); // Guardar el impuesto calculado
  } else {
    productoImpuestoVenta.value = '0.00';
  }

  // Asignar el precio de venta y el precio final a los campos correspondientes
  productoPrecioVenta.value = precioVentaSolo.toFixed(2);
  productoPrecioFinal.value = precioVenta.toFixed(2);
  productoPrecioMinimo.value = (precioCompra + (gananciaCalculada * 0.8)).toFixed(2); // Precio mínimo con 20% de ganancia
  productoPrecioXmayor.value = (precioCompra + (gananciaCalculada * 0.6)).toFixed(2); // Precio por mayor con 40% de ganancia
};

/************************************************************************/
const recalcularPventa = () => {
    // Convertir los valores a números
    const precioCompra = Number(productoPrecio.value);
    const precioVenta = Number(productoPrecioVenta.value);
    console.log("precioVenta", precioVenta);

    // Calcular la ganancia
    let gananciaCalculada = 0;
    if (!isNaN(precioCompra) && !isNaN(precioVenta) && precioCompra !== 0) {
        // Calcula la ganancia en términos absolutos
        gananciaCalculada = precioVenta - precioCompra;

        // Calcula el porcentaje de ganancia
        const gananciaPorcentaje = (gananciaCalculada / precioCompra) * 100;
        productoGanancia.value = gananciaPorcentaje.toFixed(2);
    } else {
        productoGanancia.value = '0.00';
    }

    // Calcular el precio mínimo y precio por mayor basado en la ganancia calculada
    productoPrecioMinimo.value = (precioCompra + (gananciaCalculada * 0.8)).toFixed(2); // Precio mínimo con 80% de ganancia
    productoPrecioXmayor.value = (precioCompra + (gananciaCalculada * 0.6)).toFixed(2);  // Precio por mayor con 60% de ganancia
};


/************************************************************************/
const fnBuscarRNC = async () => {
  loading.value = true;
  const rnc = datoscamposCompras.value.rnc_proveedor;

  try {
    // Realiza la consulta a través de ipcRenderer
    const response = await window.electron.ipcRenderer.invoke('consultarRNC', rnc);

    // Si se obtiene una respuesta válida
    if (response) {
      loading.value = false;

      // Formatear los datos en una lista HTML
      const formattedData = Object.entries(response)
        .map(([key, value]) => `<li><strong>${key}:</strong> ${value}</li>`)
        .join('');

      // Mostrar la información con SweetAlert2
      Swal.fire({
        title: 'Datos de la Empresa',
        html: `<ul style="text-align: left; margin: 0; padding: 0;">${formattedData}</ul>`,
        icon: 'success',
        confirmButtonText: 'Cerrar'
      });

      // Notificación de éxito
      toast.add({
        severity: 'success',
        summary: 'Encontrado',
        detail: 'Datos Encontrados',
        life: 3000
      });

      // Asignar el nombre del proveedor
      datoscamposCompras.value.proveedor = response.nombrerazon_social;
    } else {
      // Caso cuando no se encuentran datos
      loading.value = false;
      toast.add({
        severity: 'error',
        summary: 'Error',
        detail: 'Error, No se encuentran los Datos.',
        life: 3000
      });
    }
  } catch (error) {
    // Manejo de errores en caso de fallo en la solicitud
    loading.value = false;
    console.error('Error en la solicitud:', error);
    toast.add({
      severity: 'error',
      summary: 'Error',
      detail: 'Error, No se encuentran los Datos.',
      life: 3000
    });
  }
};

/************************************************************************/
/************************************************************************/
const calcularSaldoPendiente = () => {
  const total = parseFloat(datoscamposCompras.value.total) || 0;
  const abono = parseFloat(datoscamposCompras.value.abono) || 0;

  const saldo = total - abono;
  datoscamposCompras.value.saldo = saldo.toFixed(2);
};
/************************************************************************/

/************************************************************************/
watchEffect(() => {
  calcularSaldoPendiente();
    if (tipoProducto.value) {
       categoria.value = 'CELULARES';
  }

});

/************************************************************************/
const productoNombre = ref('')
const productoImpuesto = ref('0')
const productoImpuestoVenta = ref('0')
const productoGanancia = ref('0')
const productoPrecioFinal = ref('0')
const productoPrecioMinimo = ref('0')
const productoPrecioXmayor = ref('0')
const productoCatgoria = ref('GENERICO')
const productoCantidad = ref('1')
const productoCodigo = ref(generarCodigoUnico())
const productoCodigoBarra = ref(generarCodigoUnico())
const productoPrecio = ref('0.00')
const productoPrecioVenta = ref('0.00')
const tipoImpuesto = ref('0.00')
/************************************************************************/
const fnGenerarCodigo = ()=>{
  productoCodigoBarra.value = generarCodigoUnico()
}
/************************************************************************/
const handleSelectCompleteProducto = (selected)=>{
  const datosProducto = productosArray.value.find(prod=>prod.nombre === selected.value)
  if (datosProducto) {


    productoCodigo.value = datosProducto.codigo
    productoCodigoBarra.value = datosProducto.codigo_barra

    if (agregarNoCompra.value == 'Agregar No. Compra') {
        productoCodigo.value = generarCodigoUnico()
        productoCodigoBarra.value = generarCodigoUnico()
        delete datosProducto.id
    }


    productoNombre.value = datosProducto.nombre

    productoPrecio.value = datosProducto.precio_compra
    productoPrecioVenta.value = datosProducto.precio_venta
    productoImpuestoVenta.value = datosProducto.impuesto_venta
    productoGanancia.value = datosProducto.ganancia
    productoPrecioFinal.value = datosProducto.precio_final
    productoPrecioMinimo.value = datosProducto.precio_min
    productoPrecioXmayor.value = datosProducto.precio_xmayor
    categoria.value = datosProducto.categoria
    marca.value = datosProducto.marca
  }

}
/************************************************************************/
const fnLimpiarCampos = (limpiarProducto = true)=>{
    productoCodigo.value = generarCodigoUnico()
    productoCodigoBarra.value = generarCodigoUnico()
    productoNombre.value = ''
    productoPrecio.value = '0.00'
    productoPrecioVenta.value = '0.00'
    productoImpuestoVenta.value = '0.00'
    productoGanancia.value = '0.00'
    productoPrecioFinal.value = '0.00'
    productoPrecioMinimo.value = '0.00'
    productoPrecioXmayor.value = '0.00'
    productoCatgoria.value = 'GENERICO'
    formattedInput.value = ''
    if (limpiarProducto) {
    datoscamposCompras.value.productos = '[]'
  }
}
/************************************************************************/
const fnCambioImpuesto = ()=>{
productoImpuesto.value = tipoImpuesto.value
calcularPrecios()
}
/************************************************************************/
const listaProductos = ref([]);
const nuevoProducto = ref('');
/************************************************************************/
/************************************************************************/
const fnAgregarProducto = async () => {
  let camposProducto;
  let existe = false;
  const datosProducto = productosArray.value.find(prod => prod.nombre === productoNombre.value);
  
  if (datosProducto) {
    camposProducto = datosProducto;
    existe = true;
  } else {
    camposProducto = await arrayToObjetoFromTabla(link.value + api.value, tokenCifrado.value, 'productos');
    camposProducto.stock = 0;
  }

  camposProducto.stock = productoCantidad.value;
  camposProducto.codigo = productoCodigo.value;
  camposProducto.codigo_barra = productoCodigoBarra.value;
  camposProducto.nombre = productoNombre.value.toUpperCase();
  camposProducto.precio_compra = productoPrecio.value;
  camposProducto.precio_venta = productoPrecioVenta.value;
  camposProducto.oferta = productoPrecioVenta.value;
  camposProducto.precio_final = productoPrecioFinal.value;
  camposProducto.precio_min = productoPrecioMinimo.value;
  camposProducto.precio_xmayor = productoPrecioXmayor.value;
  camposProducto.no_compra = datoscamposCompras.value.no_factura;
  camposProducto.categoria = categoria.value;
  camposProducto.proveedor = datoscamposCompras.value.proveedor;
  camposProducto.impuestos = productoImpuesto.value;
  camposProducto.tipo_impuesto = addImpuestos.value
  camposProducto.created_at = nfecha('timestamp')
  camposProducto.updated_at = nfecha('timestamp')
  camposProducto.empaque = 'UNIDAD'
  camposProducto.alerta = '3'
  camposProducto.marca = marca.value
  camposProducto.ganancia = productoGanancia.value

if (agregarNoCompra.value == 'Agregar No. Compra') {
    camposProducto.nombre = productoNombre.value.toUpperCase() + ' (' + datoscamposCompras.value.no_factura + ')';
    camposProducto.descripcion = productoNombre.value.toUpperCase() + ' (' + datoscamposCompras.value.no_factura + ')';
}

  if (tipoProducto.value) {
    camposProducto.otro = formattedInput.value
  }

  const productosAgregados = JSON.parse(datoscamposCompras.value.productos);
  productosAgregados.push(camposProducto);

  datoscamposCompras.value.productos = JSON.stringify(productosAgregados);

  // Llamar a calcularTotales después de agregar el producto
  calcularTotales();

  fnLimpiarCampos(false);
};
/************************************************************************/

/************************************************************************/
const agregarProducto = () => {
  if (nuevoProducto.value.trim() !== '') {
    listaProductos.value.push(nuevoProducto.value);
    nuevoProducto.value = '';
    actualizarProductosTextarea();
  }
};

const actualizarProductosTextarea = () => {
  datoscamposCompras.value.productos = JSON.stringify(listaProductos.value);
};
/************************************************************************/
/************************************************************************/
const calcularTotales = () => {
  let subtotal = 0;
  let impuestoTotal = 0;

  const productosAgregados = JSON.parse(datoscamposCompras.value.productos);

  productosAgregados.forEach((producto) => {
    const precioCompra = parseFloat(producto.precio_compra) || 0;
    const cantidad = parseFloat(producto.stock) || 0;
    const impuesto = parseFloat(producto.impuesto_venta) || 0;

    // Calcular el subtotal (precio de compra por cantidad)
    subtotal += precioCompra * cantidad;

    // Calcular los impuestos
    impuestoTotal += (precioCompra * cantidad) * (impuesto / 100);
  });

  datoscamposCompras.value.subtotal = subtotal.toFixed(2);
  datoscamposCompras.value.impuesto = impuestoTotal.toFixed(2);
  datoscamposCompras.value.total = (subtotal + impuestoTotal).toFixed(2);
};

/************************************************************************/
const fnEdit = (index)=>{

}

const fnDel = async(index) => {
  const pagosArray = JSON.parse(datoscamposCompras.value.productos);

  Swal.fire({
    title: 'Introduce la contraseña',
    input: 'password',
    inputPlaceholder: 'Contraseña',
    showCancelButton: true,
    confirmButtonText: 'Eliminar',
    cancelButtonText: 'Cancelar'
  }).then(async(result) => {
    if (result.isConfirmed) {

      const contrasenaIngresada = result.value;

      if (contrasenaIngresada === token.value || contrasenaIngresada === tokenCorto.value ) {

        const filtrado = pagosArray.filter((_, i) => i !== index);
        datoscamposCompras.value.productos = JSON.stringify(filtrado);

        } else {
         toast.add({ severity: 'error', summary: 'Error', detail: 'Contraseña incorrecta', life: 3000 });
        }
      
    }
  })


}
/************************************************************************/

const onInput = () => {
  formattedInput.value = formatWithCommas(formattedInput.value);
};
/************************************************************************/
function formatWithCommas(value) {
  // Eliminar todas las comas y espacios en blanco existentes
  value = value.replace(/[, ]/g, ''); // Remueve comas y espacios

  // Dividir el valor en grupos de 15 caracteres y unirlos con comas
  const regex = /.{1,15}/g;
  const formattedValue = value.match(regex)?.join(',') || value;

  if (tipoProducto.value) {
    productoCantidad.value = formattedValue.split(',').length;
  }

  return formattedValue;
}
/************************************************************************/
const fnGeneraOtroCodigoCompra = ()=>{
  datoscamposCompras.value.no_factura = generarCodigoAlfaNumerico(5,'C');
}
/************************************************************************/
const fnAgregarCategoria = async ()=>{
  //agregarCategoria.value
  const datoscamposCategorias = await arrayToObjetoFromTabla(link.value+api.value,tokenCifrado.value,'categorias');
  datoscamposCategorias.nombre = agregarCategoria.value;
  const url = link.value+api.value+"/insertar/categorias";
  if (datoscamposCategorias.hasOwnProperty('created_at')) {
     datoscamposCategorias.created_at = nfecha('timestamp')
     datoscamposCategorias.updated_at = nfecha('timestamp')
    }
  const envioDatos = await enviarDatosPorPost(url, datoscamposCategorias,tokenCifrado.value);
  if (envioDatos[0] == 'ok') {
    await fetchCategorias();
     toast.add({ severity: 'success', summary: 'Éxito', detail: 'Categoria Agregada exitosamente', life: 3000 });
     visibleAgregarCategoria.value = false
     categoria.value = agregarCategoria.value;
  }else{
    toast.add({ severity: 'error', summary: 'Error', detail: 'Fallo al Agregar la categoria.', life: 3000 });
 }
}
/************************************************************************/
const verificaImpuestos = ()=>{
   if (addImpuestos.value === 'Incluido' || addImpuestos.value === 'Agregado') {
      productoImpuesto.value = datosConfiguracion.value.impuesto;
   }else{
      productoImpuesto.value = '0.00'
   }
}
/************************************************************************/
</script>
