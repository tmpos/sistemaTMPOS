<template>
  <main class="content-wrapper">
    <div class="containerS mx-auto ">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 card">
    <div class="col-span-2">
      <fieldset class="border p-3 rounded mb-2">
        <legend class="px-2">CAJA</legend>
        <Card>
          <template #title>DATOS DEL USUARIO</template>
          <template #content>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <label for="fechafacturas">Fecha</label>
    <InputText type="text" class="w-full" v-model="fechaHoy" id="fechafacturas" readonly />
  </div>

  
  <div>
    <label for="vendedoresdeldiaSelect">Vendedor</label>
    <InputText type="text" v-model="usuarioLocal.nombre" class="w-full" readonly />
  </div>
  <div>
    <label for="vendedoresdeldiatoken">Turno</label>
    <InputText type="text" v-model="usuarioLocal.token" class="w-full" id="vendedoresdeldiatoken" readonly />
  </div>
</div>

          </template>
        </Card>
      </fieldset>

      <fieldset class="border p-3 rounded mb-2">
        <legend class="px-2">FACTURAS NUEVAS</legend>
      <Card>
        <template #title>
          ACCIONES COMPLETAS
        </template>
        <template #content>
          <div style="display: flex; justify-content: flex-end;">
            <Button label="Cobrar Todo" @click="fnCobrarTodo" icon="pi pi-file" iconPos="top" />
            <Button label="Eliminar Todo" @click="fnEliminarTodo" class="ml-2" severity="danger" icon="pi pi-trash" iconPos="top" />
            <Button label="Recargar Facturas" @click="recargarFacturasFull" class="ml-2" icon="pi pi-refresh" iconPos="top" />
          </div>
        </template>
      </Card>


        <Card class="mt-2">
          <template #title>FACTURAS PENDIENTES</template>
          <template #content>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div v-for="factura in facturasSinCobrar" :key="factura.id" class="border p-3 rounded">
                <div class="flex justify-between mb-3">
                  <div>
                    <span class="block text-gray-500 font-medium mb-3" style="word-wrap: break-word; white-space: normal;">
                      {{ factura.nombre_cliente }} ({{ factura.no_factura }})
                    </span>
                    <div class="text-gray-900 font-medium text-xl">{{ factura.total }}</div>
                  </div>
                  <div class="flex items-center justify-center bg-blue-100 border-round" style="width: 2.5rem; height: 2.5rem">
                    <i class="pi text-blue-500 text-xl" :class="'icon-' + tipoFactura[factura.metodo_pago].icono"></i>
                  </div>
                </div>
                <div>
                  <span class="info-box-number">
               <ButtonGroup>
                      <Button label="Cobrar" @click="cobrarFactura(factura)" icon="pi pi-check" severity="success" />
                      <Button label="Prods" @click="fnProductos(factura)" icon="pi pi-eye" severity="secondary" />
                      <Button label="Imprimir" @click="fnImprimirFactura(factura)" icon="pi pi-print" severity="secondary" />
                      <Button label="Quitar" @click="eliminarFactura(factura.no_factura, factura.id)" icon="pi pi-times" severity="danger" />
                    </ButtonGroup>
                  </span>
                </div>
              </div>
            </div>
          </template>
        </Card>
      </fieldset>
    </div>

    <div class="col-span-1">
      <fieldset class="border p-3 rounded mb-2">
        <legend class="px-2">ACCIONES DE CAJA</legend>
        <Card>
          <template #title>Botones de Acción</template>
          <template #content>
            <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
              <Button label="AGREGAR ABONO" @click="visibleabono = true" icon="pi pi-money-bill" iconPos="top" />
              <Button label="AGREGAR ENTRADA" @click="visiblentrada = true" icon="pi pi-shopping-bag" iconPos="top" />
              <Button label="AGREGAR GASTO" @click="visiblegastos = true" icon="pi pi-wallet" iconPos="top" />
              <Button label="C. POR COBRAR" as="router-link" to="/cuentas_cobrar" icon="pi pi-wallet" iconPos="top" />
              <Button label="FACTURAS" @click="visibleimprimirfactura = true" icon="pi pi-print" iconPos="top" />
              <Button label="TALLER" v-if="datosDefault.modo === 'CELULAR' || datosDefault.modo === 'FULL'" @click="visibletaller = true" icon="pi pi-wrench" iconPos="top" />
              <Button label="TRANSACCIONES"  @click="visibleTransacciones = true" icon="pi pi-arrow-right-arrow-left" iconPos="top" />
              <Button label="PRODUCTOS" as="router-link" to="/productos" icon="pi pi-th-large" iconPos="top" />
              <Button label="VENDER" as="router-link" to="/vender" icon="pi pi-cart-plus" iconPos="top" />
              <Button label="CUADRAR CAJA" @click="cuadrarCaja = true" icon="pi pi-file" iconPos="top" />
          <!--     <Button label="REGISTRAR SOCIOS" @click="registrarSocios = true" icon="pi pi-users" iconPos="top" /> -->
              <Button label="REALIZAR CIERRE" @click="fnRealizarCierre" icon="pi pi-times-circle" iconPos="top" />
              <Button label="CONSULTA IA" @click="visibleIA = true" v-if="datosDefault.modo === 'CELULAR' || datosDefault.modo === 'FULL'" icon="pi pi-comments" iconPos="top" />
            </div>
          </template>
        </Card>
      </fieldset>
    </div>


    <div class="col-span-3">
      <fieldset class="border p-3 rounded mb-2">
        <legend class="px-2">COBRO DE FACTURAS</legend>
      </fieldset>
    </div>
  </div>
</div>


   <Toast />

<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->

<Dialog v-model:visible="registrarSocios" position="top" modal :style="{ width: '50rem' }" header="registrarSocios">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Registrar Socios</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">Registrar Socios</legend>
    <div class="grid grid-cols-12  gap-4">
      <div class="col-span-12 md:col-span-4">
        <label >CODIGO</label>
        <InputText
          type="text"
          v-model="registroSocios.codigo"
          placeholder="Codigo"
          v-solonumeros
          @keyup="verificaCodigoSocio"
          @keydown.enter="verificaCodigoSocio"
          class="w-full"
        />
      </div>
      <div class="col-span-12 md:col-span-8">
        <label >NOMBRE</label>
        <InputText
          type="text"
          v-model="registroSocios.nombre"
          placeholder="Nombre"
          v-mayuscula
          class="w-full"
        />
      </div>

      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >CEDULA</label>
        <InputText
          type="text"
          v-model="registroSocios.cedula"
          placeholder="Cedula"
          v-solonumeros
          fluid
          @keydown.enter="cobrandoFactura"
        />
      </div>

      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >TELEFONO</label>
        <InputText
          type="text"
          v-model="registroSocios.telefono"
          placeholder="Telefono"
          v-solonumeros
          class="w-full"
        />
      </div>


      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >EMAIL</label>
        <InputText
          type="text"
          v-model="registroSocios.email"
          placeholder="Email"
          class="w-full"
        />
      </div>


      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >SEXO</label>
        <Select v-model="registroSocios.sexo"
         :options="['HOMBRE','MUJER']"
         fluid
           />
      </div>

      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >CUMPLEAÑO</label>
        <InputText
          type="text"
          v-model="registroSocios.fecha_nacimiento"
          placeholder="Fecha de Nacimiento"
          class="w-full"
        />
      </div>

      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <label >EDAD</label>
        <InputText
          type="text"
          v-model="registroSocios.edad"
          placeholder="Edad"
          class="w-full"
        />
      </div>

      <div class="col-span-12 ">
        <label >DIRECCION</label>
        <InputText
          type="text"
          v-model="registroSocios.direccion"
          placeholder="Direccion"
          class="w-full"
        />
      </div>

    </div>
  </fieldset>

  <template #footer>
      <Button label="Agregar Socio" outlined severity="secondary" @click="fnAgregarSocio"  />
      <Button label="Cerrar" outlined severity="secondary" @click="registrarSocios = false"  />
  </template>
</Dialog>


<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visiblecobrar" modal :style="{ width: '50rem' }" header="Cobrar Factura">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Cobrar Factura</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">Cobrar</legend>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label for="moneyrecibido">RECIBIDO</label>
        <InputText
          type="text"
          ref="moneyrecibidoRef"
          id="dineroRecibido"
          v-model="recibidoFactura"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          placeholder="moneyrecibido"
          v-solonumeros
          v-numeroFocusinOut
          v-tecladovirtual="(event) => handleFocus('number', event.target)"
          @keyup="calcularVuelto"
          @keydown.enter="cobrandoFactura"
          class="w-full"
        />
      </div>

      <div>
        <label for="moneyrecibido">TOTAL</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="totalFactura"
          readonly
          class="w-full"
        />
      </div>

      <div>
        <label for="moneyrecibido">DEVUELTA</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="devueltaFactura"
          readonly
          class="w-full"
        />
      </div>

      <div>
        <label for="moneyrecibido">EFECTIVO</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="facturaEfectivo"
          v-tecladovirtual="(event) => handleFocus('number', event.target)"
          v-solonumeros
          v-decimales
          v-numeroFocusinOut
          @blur="handleEfectivoChange"
          class="w-full"
        />
      </div>

      <div>
        <label for="moneyrecibido">TARJETA</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="facturaTarjeta"
          v-tecladovirtual="(event) => handleFocus('number', event.target)"
          v-solonumeros
          v-decimales
          v-numeroFocusinOut
          @blur="handleTarjetaChange"
          class="w-full"
        />
      </div>

      <div>
        <label for="moneyrecibido">TRANSFERENCIA</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="facturaTransferencia"
          v-tecladovirtual="(event) => handleFocus('number', event.target)"
          v-solonumeros
          v-decimales
          v-numeroFocusinOut
          @blur="handleTransferenciaChange"
          class="w-full"
        />
      </div>

      <!-- Campo agregado para Propina -->
      <div>
        <label for="moneyrecibido">PROPINA</label>
        <InputText
          type="text"
          style="height: 5rem; font-size: 2.5rem; padding: 0.5rem;"
          v-model="propinaFactura"
          v-tecladovirtual="(event) => handleFocus('number', event.target)"
          v-solonumeros
          v-decimales
          v-numeroFocusinOut
          @keyup="handlePropinaChange"
          @keydown.enter="cobrandoFactura"
          class="w-full"
        />
      </div>
    </div>
  </fieldset>

  <template #footer>
    <Button label="Deja el cambio de Propina (F1)" text severity="secondary" @click="fnDejaCambioPropina" />
    <Button label="Cobrar Por Tarjeta (F2)" text severity="secondary" @click="fnCobrarPorTarjeta" />
    <Button label="Cobrar Por Transferencia (F3)" text severity="secondary" @click="fnCobrarPorTransferencia" />
    <Button label="Cancel" text severity="secondary" @click="visiblecobrar = false" />
    <Button label="Cobrar" outlined severity="secondary" @click="cobrandoFactura" />
  </template>
</Dialog>


<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visibleimprimirfactura" modal :style="{ width: '50rem' }" header="Imprimir Factura">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Imprimir Factura</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">Impresión</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="ingresenumeroModifcarfactura">INGRESE # FACTURA</label>
        <InputGroup>
          <Dropdown
            v-model="campoFactura"
            @change="facturaSeleccionada"
            filter
            editable
            :options="facturas"
            optionLabel="no_factura"
            placeholder="Seleccione una Factura"
            class="w-full"
          />
          <Button icon="pi pi-sync" @click="recargarFacturas" severity="success" />
        </InputGroup>
      </div>

      <div>
        <label for="elegirimpresora">Elige la Impresora</label>
        <Dropdown
          v-model="impresoraSeleccionada"
          :options="[
            { label: 'Impresora Normal', value: 'Impresora Normal' },
            { label: 'Impresora Térmica', value: 'Impresora Ticket' },
            { label: 'Impresora Térmica 2', value: 'Offline' }
          ]"
          optionLabel="label"
          optionValue="value"
          placeholder="Seleccione una Impresora"
          class="w-full"
        />
      </div>

      <div class="col-span-2">
        <label for="elegircliente">Nombre de Cliente</label>
        <InputText
          type="text"
          v-model="campoNombreFactura"
          class="w-full"
          id="elegircliente"
        />
      </div>
    </div>
  </fieldset>

  <template #footer>
    <Button label="Cancel" text severity="secondary" @click="visibleimprimirfactura = false" autofocus />
    <Button label="Imprimir" outlined severity="secondary" @click="imprimirFactura" autofocus />
  </template>
</Dialog>

<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visiblegastos" modal :style="{ width: '50rem' }" header="Gastos">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">Gastos</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">Gastos</legend>
    <div class="grid grid-cols-12  gap-4">
      <div class="col-span-3">
        <label for="cantidadAgregarDatos">CANTIDAD</label>
        <InputText
          v-model="camposGastos.cantidad"
          v-solonumeros
          v-numeroFocusinOut
          v-decimales
          class="w-full"
          id="cantidadAgregarDatos"
          placeholder="cantidad"
          maxlength="250"
        />
      </div>

      <div class="col-span-3">
        <label for="fechaAgregarDatos">FECHA</label>
        <Calendar
          v-model="camposGastos.fecha"
          class="w-full"
          id="fechaAgregarDatos"
          placeholder="fecha"
          maxlength="250"
        />
      </div>


      <div class="col-span-3">
        <label for="horaAgregarDatos">HORA</label>
        <InputText
          type="text"
          v-model="camposGastos.hora"
          class="w-full"
          id="horaAgregarDatos"
          placeholder="hora"
          maxlength="250"
        />
      </div>

      <div class="col-span-3">
        <label for="metodoAgregarDatos">METODO</label>
        <Select v-model="camposGastos.metodo" fluid :options="['EFECTIVO','TRANSFERENCIA']"  />
      </div>

      <div class="col-span-4" hidden>
        <label for="turnoAgregarDatos">TURNO</label>
        <InputText
          type="text"
          v-model="camposGastos.turno"
          class="w-full"
          id="turnoAgregarDatos"
          readonly
          placeholder="turno"
          maxlength="250"
        />
      </div>


      <div class="col-span-4" hidden>
        <label for="mesAgregarDatos">MES</label>
        <InputText
          v-model="camposGastos.mes"
          v-solonumeros
          v-numeroFocusinOut
          class="w-full"
          id="mesAgregarDatos"
          placeholder="mes"
          maxlength="250"
        />
      </div>

      <div class="col-span-4" hidden>
        <label for="yearAgregarDatos">YEAR</label>
        <InputText
          v-model="camposGastos.year"
          v-solonumeros
          v-numeroFocusinOut
          class="w-full"
          id="yearAgregarDatos"
          placeholder="year"
          maxlength="250"
        />
      </div>
      <div class="col-span-12">
        <label for="descripcionAgregarDatos">DESCRIPCION</label>
        <Textarea
          v-model="camposGastos.descripcion"
          class="w-full"
          id="descripcionAgregarDatos"
          name="descripcion"
          rows="3"
        />
      </div>
    </div>
  </fieldset>

  <template #footer>
    <Button label="Ultimo" icon="pi pi-print" outlined severity="secondary" @click="imprimirUltimoGasto" autofocus />
    <Button label="Agregar Gasto" icon="pi pi-plus" outlined severity="secondary" @click="agregarGasto" autofocus />
    <Button label="Cerrar" text severity="secondary" @click="visiblegastos = false" autofocus />
  </template>
</Dialog>

<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visibleabono" modal :position="position" header="Editar Producto" :style="{ width: '50rem' }">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">ABONO</span>
    </div>
  </template>

      <fieldset class="border p-3 rounded mb-2">
        <legend class="float-none w-auto px-2">ABONO</legend>
          <div class="row">


          </div>
      </fieldset>

  <template #footer>
    <Button label="Cancel" text severity="secondary" @click="visibleabono = false" autofocus />
    <Button label="Imprimir" outlined severity="secondary" @click="imprimirAbono" autofocus />
  </template>
</Dialog>
<!-- ////////////////////////////////////////////////////////////////////////////////////////// -->
<Dialog v-model:visible="visiblentrada" modal :style="{ width: '50rem' }" header="ENTRADA">
  <template #header>
    <div class="inline-flex align-items-center justify-content-center gap-2">
      <span class="font-bold white-space-nowrap">ENTRADA</span>
    </div>
  </template>

  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">ENTRADA</legend>
    <div class="grid grid-cols-12  gap-4">
      <div class="col-span-4">
        <label for="cantidadAgregarDatos">CANTIDAD</label>
        <InputNumber
          v-model="camposEntrada.cantidad"
          v-solonumeros
          v-numeroFocusinOut
          v-decimales
          class="w-full"
