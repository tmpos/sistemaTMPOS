      severity="contrast"
      @click="funcionActualizar"
    />


    <Button
      icon="pi pi-print"
      class="ms-1"
      severity="contrast"
      @click="fnPrint"
    />

    </div>


</fieldset>
<section>
<fieldset class="border p-3 rounded mb-2">
  <legend class="float-none w-auto px-2">Campos</legend>
    <form id="formularioGenerar" action="" method="">

 <div class="flex mb-2 gap-2 justify-end">
            <Button @click="value = '0'" rounded label="1" class="w-8 h-8 p-0" :outlined="value !== '0'" />
            <Button @click="value = '1'" rounded label="2" class="w-8 h-8 p-0" :outlined="value !== '1'" />
            <Button @click="value = '2'" rounded label="3" class="w-8 h-8 p-0" :outlined="value !== '2'" />
        </div>

        <Tabs v-model:value="value">
            <TabList>
                <Tab value="0">Datos Cliente</Tab>
                <Tab value="1">Detalles Reclamación</Tab>
                <Tab value="2">Resultado Reclamación</Tab>
            </TabList>
            <TabPanels>
                <TabPanel value="0">
         <div class="box-body">
          <div class="grid grid-cols-12 gap-4 mt-4 text-blue-600" id="campos">

<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
                <label for="nombre" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Nombre</label>
                <InputText type="text"  v-mayuscula class="form-input w-full " v-model="datoscampos.nombre" name="nombre" placeholder="nombre" id="actualizarnombre" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                <label for="telefono" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Telefono</label>
                <InputText type="text"  v-maska="patronTelefono" class="form-input w-full " v-model="datoscampos.telefono" name="telefono" placeholder="telefono" id="actualizartelefono" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                <label for="whatsapp" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Whatsapp</label>
                <InputText type="text"  v-maska="patronTelefono" class="form-input w-full " v-model="datoscampos.whatsapp" name="whatsapp" placeholder="whatsapp" id="actualizarwhatsapp" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Email</label>
                <InputText type="text"  class="form-input w-full " v-model="datoscampos.email" name="email" placeholder="email" id="actualizaremail" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="institucion" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Institucion</label>
                   <Dropdown editable v-model="datoscampos.institucion" :options="['']" placeholder="Seleccione institucion" class="w-full" />

            </div>
            </div>
            </div>
                </TabPanel>
                <TabPanel value="1">
         <div class="box-body">
          <div class="grid grid-cols-12 gap-4 mt-4 text-blue-600" id="campos">

<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                <label for="no_reclamacion" class="block text-sm font-medium text-gray-700 dark:text-gray-400">No reclamacion</label>
                <InputText type="text"  class="form-input w-full " v-model="datoscampos.no_reclamacion" name="no_reclamacion" placeholder="no_reclamacion" id="actualizarno_reclamacion" readonly />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                <label for="fecha_emision" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha emision</label>
                <InputText type="text"  class="form-input w-full " v-model="datoscampos.fecha_emision" name="fecha_emision" placeholder="fecha_emision" id="actualizarfecha_emision" readonly />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="fecha_respuesta" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha respuesta</label>
                   <DatePicker  v-model="datoscampos.fecha_respuesta" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="fecha_vencimiento" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha vencimiento</label>
                   <DatePicker  v-model="datoscampos.fecha_vencimiento" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
                    <label for="descripcion_reclamo" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Descripcion reclamo</label>
                   <Textarea id="actualizardescripcion_reclamo"  v-model="datoscampos.descripcion_reclamo" name="descripcion_reclamo" rows="3" class="form-textarea w-full " placeholder="Enter Descripcion_reclamo"></textarea>
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
                <label for="articulo_reclamado" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Articulo reclamado</label>
                <InputText type="text"  v-mayuscula class="form-input w-full " v-model="datoscampos.articulo_reclamado" name="articulo_reclamado" placeholder="articulo_reclamado" id="actualizararticulo_reclamado" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-4 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="fecha_compra" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha compra</label>
                   <DatePicker  v-model="datoscampos.fecha_compra" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-4 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="estado_reclamacion" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Estado reclamacion</label>
                    <Dropdown editable v-model="datoscampos.estado_reclamacion" :options="['ABIERTO','CERRADO']" placeholder="Seleccione estado_reclamacion" class="w-full" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-4 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="resultado_reclamacion" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Resultado reclamacion</label>
                    <Dropdown editable v-model="datoscampos.resultado_reclamacion" :options="['FAVORABLE','DESFAVORABLE']" placeholder="Seleccione resultado_reclamacion" class="w-full" />
            </div>
            </div>
            </div>
                </TabPanel>
                <TabPanel value="2">
         <div class="box-body">
          <div class="grid grid-cols-12 gap-4 mt-4 text-blue-600" id="campos">
<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
                <label for="respuesta_reclamo" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Respuesta reclamo</label>
                <InputText type="text"  class="form-input w-full " v-model="datoscampos.respuesta_reclamo" name="respuesta_reclamo" placeholder="respuesta_reclamo" id="actualizarrespuesta_reclamo" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-6 xl:col-span-6 2xl:col-span-6">
                    <label for="fecha_cierre" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha cierre</label>
                   <DatePicker  v-model="datoscampos.fecha_cierre" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-6 xl:col-span-6 2xl:col-span-6">
                <label for="representante" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Representante</label>
                <InputText type="text"  v-mayuscula class="form-input w-full " v-model="datoscampos.representante" name="representante" placeholder="representante" id="actualizarrepresentante" />
            </div>
            </div>
            </div>
                </TabPanel>
