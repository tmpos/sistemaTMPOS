                    <TextArea class="form-input w-full "  v-model="datoscamposReclamaciones.respuesta_reclamo" placeholder="respuesta_reclamo" name="crearrespuesta_reclamo" id="respuesta_reclamo" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-6 xl:col-span-6 2xl:col-span-6">
                    <label for="fecha_cierre" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha cierre</label>
                   <DatePicker  v-model="datoscamposReclamaciones.fecha_cierre" showButtonBar fluid />
            </div>
