                   <Textarea id="creardescripcion_reclamo" rows="3" class="form-textarea w-full "  v-model="datoscamposReclamaciones.descripcion_reclamo" placeholder="Descripcion_reclamo"></textarea>
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
                    <label for="articulo_reclamado" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Articulo reclamado</label>
                    <InputText type="text" class="form-input w-full "  v-mayuscula v-model="datoscamposReclamaciones.articulo_reclamado" placeholder="articulo_reclamado" name="creararticulo_reclamado" id="articulo_reclamado" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="fecha_compra" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Fecha compra</label>
                   <DatePicker  v-model="datoscamposReclamaciones.fecha_compra" showButtonBar fluid />
            </div>

<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="fecha_compra" class="block text-sm font-medium text-gray-700 dark:text-gray-300">No factura</label>
<InputGroup>
    <InputText v-model="datoscamposReclamaciones.no_factura" placeholder="No Factura" v-solonumeros />
    <InputGroupAddon>
        <Button icon="pi pi-search"  @click="fnBuscarFactura" />
    </InputGroupAddon>
</InputGroup>

            </div>


<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="estado_reclamacion" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Estado reclamacion</label>

              <Dropdown v-model="datoscamposReclamaciones.estado_reclamacion" :options="['ABIERTO','CERRADO']" placeholder="Seleccione estado_reclamacion" class="w-full" />
            </div>

<div class="col-span-12 sm:col-span-12 md:col-span-3 lg:col-span-3 xl:col-span-3 2xl:col-span-3">
                    <label for="resultado_reclamacion" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Resultado reclamacion</label>

              <Dropdown v-model="datoscamposReclamaciones.resultado_reclamacion" :options="['EN ESPERA','FAVORABLE','DESFAVORABLE']" placeholder="Seleccione resultado_reclamacion" class="w-full" />
            </div>

            </div>
            </div>
                </TabPanel>
                <TabPanel value="2">
        <div class="box-body">
