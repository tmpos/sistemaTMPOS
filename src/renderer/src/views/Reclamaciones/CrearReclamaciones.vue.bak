                    <label for="representante" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Representante</label>
                    <InputText type="text" class="form-input w-full "  v-mayuscula v-model="datoscamposReclamaciones.representante" placeholder="representante" name="crearrepresentante" id="representante" />
