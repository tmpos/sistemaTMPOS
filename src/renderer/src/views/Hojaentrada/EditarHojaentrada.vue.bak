<select class="form-control " id="grua-Actualizador" v-model="datoscampos.grua" name="grua" >
  <option value="NO">NO</option>
<option value="SI">SI</option>
</select></div>
<div class="form-group col-12 col-sm-3 col-md-3 col-lg-3 col-xl-3" >
