<input type="input" v-model="datoscampos.hora" name="hora"  class="form-control" id="hora-Actualizador"  placeholder="hora"  maxlength="250">
</div>



<div class="form-group col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12" >
  <fieldset class="border p-3 rounded mb-2">
    <legend class="float-none w-auto px-2">FALLAS ELECTRONICAS EN TABLERO</legend>
<div class="row">
  <div class="col-12 col-md-6 row">
<div class="col-3 " v-for="(value, key) in datoscampos.fallas_electronicas_en_tablero" :key="key">
    <div>{{ key }}</div>
    <InputSwitch v-model="datoscampos.fallas_electronicas_en_tablero[key]"  :id="'switch-' + key" @change="fnprueba"  />
</div>
    
  </div>
  <div class="col-12 col-md-6">
        <div class="card flex justify-content-center">
        <img src="../../assets/img/carrito.png" alt="carrito">

    </div>
  </div>
</div>
</fieldset>
</div>





<div class="form-group col-12" >
  <fieldset class="border p-3 rounded mb-2">
