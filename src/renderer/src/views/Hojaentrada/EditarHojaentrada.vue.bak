<input type="input" v-model="datoscampos.modelo" name="modelo"  class="form-control" id="modelo-Actualizador"  placeholder="modelo" v-mayuscula maxlength="250">
</div>
<div class="form-group col-12 col-sm-2 col-md-2 col-lg-2 col-xl-2" >
<label for="year-Actualizador">YEAR</label>
<input type="input" v-model="datoscampos.year" name="year"  class="form-control" id="year-Actualizador"  placeholder="year" v-solonumeros maxlength="250">
</div>
<div class="form-group col-12 col-sm-2 col-md-2 col-lg-2 col-xl-2" >
<label for="color-Actualizador">COLOR</label>

  <div class="input-group">
    <input
      type="text"
      v-model="datoscampos.color"
      class="form-control"
      id="colorAgregarDatos"
    />
    <div class="input-group-append">
      <color-picker  v-model="datoscampos.color" />
    </div>
  </div>

</div>
<div class="form-group col-12 col-sm-4 col-md-4 col-lg-4 col-xl-4" >
<label for="placa-Actualizador">PLACA</label>
<input type="input" v-model="datoscampos.placa" name="placa"  class="form-control" id="placa-Actualizador"  placeholder="placa"  maxlength="250">
</div>
<div class="form-group col-12 col-sm-2 col-md-2 col-lg-2 col-xl-2" >
<label for="km-Actualizador">KM</label>
<input type="input" v-model="datoscampos.km" name="km"  class="form-control" id="km-Actualizador"  placeholder="km"  maxlength="250">
</div>
<div class="form-group col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6" >
<label for="combustible-Actualizador">COMBUSTIBLE</label>

<div class="row">
  <div class="col-6 col-md-8"><select name="combustible" id="combustibleAgregarDatos" class="form-control " v-model="datoscampos.combustible">
  <option value="0">0</option>
  <option value="10">10</option>
  <option value="25">25</option>
  <option value="40">40</option>
  <option value="50">50</option>
  <option value="75">75</option>
  <option value="90">90</option>
  <option value="90">90</option>
  <option value="100">100</option>
</select></div>
  <div class="col-6 col-md-4"><Knob v-model="datoscampos.combustible" valueTemplate="{value}%" /></div>
</div>


</div>
<div class="form-group col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6" >
<label for="bateria-Actualizador">BATERIA</label>
<input type="input" v-model="datoscampos.bateria" name="bateria"  class="form-control" id="bateria-Actualizador"  placeholder="bateria" v-mayuscula maxlength="250">
</div>
<div class="form-group col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6" >
<label for="tipo_combustible-Actualizador">TIPO_COMBUSTIBLE</label>
<select class="form-control " id="tipo_combustible-Actualizador" v-model="datoscampos.tipo_combustible" name="tipo_combustible" >
  <option value="GASOLINA">GASOLINA</option>
<option value="DIESEL">DIESEL</option>
<option value="GAS">GAS</option>
<option value="ELECTRICO">ELECTRICO</option>
</select></div>
<div class="form-group col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6" >
