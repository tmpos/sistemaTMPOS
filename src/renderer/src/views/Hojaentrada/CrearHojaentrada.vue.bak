<div class="row">
      <div class="card col-12 col-md-3">
        <Fieldset legend="ABOLLADURAS & RAYADURAS">
         <div class="row">
          <div class="col-12 row">
        <div class="col-6 " v-for="(value, key) in datoscamposHojaentrada.abolladuras_rayaduras" :key="key">
