            <InputSwitch v-model="datoscamposHojaentrada.abolladuras_rayaduras[key]"  :id="'switch-' + key"   />
        </div>
            
          </div>
         </div>
        </Fieldset>
    </div>
      <div class="card col-12 col-md-3">
        <Fieldset legend="ROTURA">
         <div class="row">
          <div class="col-12 row">
        <div class="col-6 " v-for="(value, key) in datoscamposHojaentrada.rotura" :key="key">
            <div>{{ key }}</div>
            <InputSwitch v-model="datoscamposHojaentrada.rotura[key]"  :id="'switch-' + key"   />
        </div>
            
          </div>
         </div>
        </Fieldset>
    </div>


      <div class="card col-12 col-md-3">
        <Fieldset legend="NO FUNCIONA">
         <div class="row">
          <div class="col-12 row">
        <div class="col-6 " v-for="(value, key) in datoscamposHojaentrada.no_funciona" :key="key">
            <div>{{ key }}</div>
            <InputSwitch v-model="datoscamposHojaentrada.no_funciona[key]"  :id="'switch-' + key"   />
        </div>
            
          </div>
         </div>
        </Fieldset>
    </div>

      <div class="card col-12 col-md-3">
        <Fieldset legend="EQUIPO">
         <div class="row">
          <div class="col-12 row">
        <div class="col-6 " v-for="(value, key) in datoscamposHojaentrada.equipos" :key="key">
            <div>{{ key }}</div>
