<script setup>
import { ref, onMounted, nextTick, watchEffect,watch } from 'vue';
import router from '../../router';
import axios from 'axios';
import * as XLSX from 'xlsx';
import jsPDF from 'jspdf';
import html2canvas from 'html2canvas';
import 'jspdf-autotable';
import LoadingOverlay from '../../Loading/LoadingOverlay.vue';
import {enviarDatosPorPost,
  eliminarDatos, 
  obtenerIdsSeleccionados,
  borrarTodoslosDatos,
  lenguajeDataTable,
  nfecha,
  arrayToObjetoFromTabla,
  peticionesFetch,
  encryptarPassword,
  transformarFechaTimestamp,
  agregarDiasalaFechaActual,
  envioElectron,
  mensajetoast,
  lasMayusculas} from '../../funciones/funciones.js';
  import bcrypt from 'bcryptjs';
import Swal from 'sweetalert2'
import { useToast } from "primevue/usetoast";
const toast = useToast();
/************************************************************************/
const loading = ref(true)
/************************************************************************/
import {useDatosEmpresa} from '../../stores'
const datosEmpresa = useDatosEmpresa();
const link = ref(null);
const api = ref(null);
const token = ref(null);
const patronTelefono = ref(null);
const linkImpresora = ref(null);
const patroncedula = ref(null);
const tokenCifrado = ref(null);
/************************************************************************/
const asientoDiario = ref([]);
const cuentas = ref({});
/************************************************************************/
const fechaInicio = ref('')
const horaInicio = ref('')
const fechaFin = ref('')
const horaFin = ref('')
/************************************************************************/
watchEffect(() => {
    //Aqui para vigilar eventos
});
/************************************************************************/
function getTimestamps() {
  const now = new Date();

  // Primer día del mes
  const firstDayOfMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 1);

  // Fecha y hora actual
  const currentDay = new Date();

  // Convertir a timestamp en formato 'YYYY-MM-DD HH:MM:SS'
  const formatTimestamp = (date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const seconds = String(date.getSeconds()).padStart(2, '0');

    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  };

  return {
    firstDayOfMonth: formatTimestamp(firstDayOfMonth),
    currentDay: formatTimestamp(currentDay),
  };
}
/************************************************************************/
const fetchAsientoDiario = async () => {
  try {
    const usuarioLocal = JSON.parse(window.localStorage.getItem('usuarioLocal'))[0];
    const datosAsientoDiario = await peticionesFetch(
      `${link.value}${api.value}`, 
      `datosarray/asientodiario`, 
      {}, 
      tokenCifrado.value, 
      'GET'
    );

    // Function to ensure the date is formatted as 'yyyy-mm-dd'
    const formatDate = (dateInput) => {
      if (typeof dateInput === 'string') {
        return dateInput;
      } else if (dateInput instanceof Date) {
        const year = dateInput.getFullYear();
        const month = String(dateInput.getMonth() + 1).padStart(2, '0');
        const day = String(dateInput.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }
      return '';
    };

    // Function to ensure time is formatted as 'hh:mm:ss'
    const formatTime = (timeInput) => {
      if (typeof timeInput === 'string') {
        return timeInput;
      } else if (timeInput instanceof Date) {
        const hours = String(timeInput.getHours()).padStart(2, '0');
        const minutes = String(timeInput.getMinutes()).padStart(2, '0');
        const seconds = String(timeInput.getSeconds()).padStart(2, '0');
        return `${hours}:${minutes}:${seconds}`;
      }
      return '00:00:00'; // Default if time is not set correctly
    };

    // Format dates and times
    const startDateStr = `${formatDate(fechaInicio.value)} ${formatTime(horaInicio.value)}`;
    const endDateStr = `${formatDate(fechaFin.value)} ${formatTime(horaFin.value)}`;

    const startDate = new Date(startDateStr);
    const endDate = new Date(endDateStr);


    // Filter the array based on the date range
    const filteredAsientoDiario = datosAsientoDiario.filter(item => {
      const updatedAt = new Date(item.updated_at);
      return updatedAt >= startDate && updatedAt <= endDate;
    });

    // Assign the filtered results to asientoDiario
    asientoDiario.value = filteredAsientoDiario;

    // Call generarMayorGeneral with the filtered data
    generarMayorGeneral(asientoDiario.value);

    // Force Vue to update the DOM after the data changes
    await nextTick();

  } catch (error) {
    toast.add({severity: 'error', summary: 'Error', detail: 'Failed to fetch asiento diario', life: 3000});
  }
};

/************************************************************************/




function generarMayorGeneral(datosAsientoDiario) {
  const movimientos = [];

  function crearMovimiento(cuenta, fecha, descripcion, debito, credito, numero) {
    const movimientoExistente = movimientos.find(movimiento => movimiento.cuenta === cuenta && movimiento.numero === numero);

    if (movimientoExistente) {
      movimientoExistente.debito += debito;
      movimientoExistente.credito += credito;
    } else {
      movimientos.push({
        cuenta: cuenta,
        fecha: fecha,
        descripcion: descripcion,
        debito: debito,
        credito: credito,
        numero: numero
      });
    }
  }

  // Procesar cada entrada en el asiento diario
  datosAsientoDiario.forEach(entrada => {
    const asiento = JSON.parse(entrada.asiento);

    asiento.forEach(cuenta => {
      const debito = parseFloat(cuenta.cantidadDebito) || 0;
      const credito = parseFloat(cuenta.cantidadCredito) || 0;
      const cuentaNombre = cuenta.debito;
      const cuentaContraparte = cuenta.credito;

      crearMovimiento(cuentaNombre, entrada.fecha, entrada.descripcion, debito, 0, entrada.numero);
      crearMovimiento(cuentaContraparte, entrada.fecha, entrada.descripcion, 0, credito, entrada.numero);
    });
  });

  const newCuentas = {};

  // Agrupar movimientos por cuenta y calcular saldo
  movimientos.forEach(movimiento => {
    const { cuenta, fecha, descripcion, debito, credito } = movimiento;

    if (!newCuentas[cuenta]) {
      newCuentas[cuenta] = {
        saldo: 0,
        movimientos: []
      };
    }

    newCuentas[cuenta].saldo += credito - debito;
    newCuentas[cuenta].movimientos.push({
      fecha,
      descripcion,
      debito,
      credito,
      saldo: newCuentas[cuenta].saldo
    });
  });

  cuentas.value = newCuentas;
}

/************************************************************************/
onMounted(async() => {

const datosJSON = await envioElectron('datosarchivo');
link.value = datosJSON.VITE_LINKURL;
api.value = datosJSON.VITE_LINK_API;
token.value = datosJSON.VITE_TOKEN;
patronTelefono.value = datosJSON.VITE_PATRON_TELEFONO;
linkImpresora.value = datosJSON.VITE_IMPRESORA_LOCAL;

tokenCifrado.value = await encryptarPassword(token.value, 10);
    if (!datosEmpresa.empresa.nombre) {
    await datosEmpresa.inicializarDatosEmpresa(link.value+api.value);
  }


fechaInicio.value = transformarFechaTimestamp(agregarDiasalaFechaActual(-30),false)
horaInicio.value = '00:00:00'
fechaFin.value = nfecha('fechaAmericana')
horaFin.value = nfecha('horaAmericana')

await fetchAsientoDiario();
loading.value = false
});
/************************************************************************/
const exportarExcel = () => {
  loading.value = true
  try {
    // Prepare data for each table (each 'cuenta')
    const worksheetData = Object.entries(cuentas.value).map(([cuentaName, cuentaData]) => {
      // Create a header row
      const header = ['Fecha', 'Descripción', 'Débito', 'Crédito', 'Saldo'];
      
      // Map each movement into a row of data
      const rows = cuentaData.movimientos.map(movimiento => [
        movimiento.fecha,
        movimiento.descripcion,
        movimiento.debito.toFixed(2),
        movimiento.credito.toFixed(2),
        movimiento.saldo.toFixed(2)
      ]);

      // Add the header at the beginning
      rows.unshift(header);

      // Convert the array of arrays into a worksheet
      const worksheet = XLSX.utils.aoa_to_sheet(rows);

      return { name: cuentaName, worksheet };
    });

    // Create a new workbook and append each worksheet
    const workbook = XLSX.utils.book_new();
    worksheetData.forEach(({ name, worksheet }) => {
      XLSX.utils.book_append_sheet(workbook, worksheet, name);
    });

    // Generate Excel file and trigger download
    XLSX.writeFile(workbook, 'MayorGeneral.xlsx');

    toast.add({ severity: 'success', summary: 'Éxito', detail: 'Archivo Excel generado con éxito.', life: 3000 });
    loading.value = false
  } catch (error) {
    console.error('Error exporting to Excel:', error);
    toast.add({ severity: 'error', summary: 'Error', detail: 'No se pudo generar el archivo Excel.', life: 3000 });
    loading.value = false
  }
};
/************************************************************************/
/************************************************************************/
const exportarPDF = () => {
  try {
    const pdf = new jsPDF('p', 'mm', 'a4'); // A4 size page in portrait mode

    // Loop through each "cuenta" to create a table for each
    Object.entries(cuentas.value).forEach(([cuentaName, cuentaData], index) => {
      // Add a title for each cuenta
      pdf.setFontSize(16);
      pdf.text(cuentaName, 14, 20 + index * 10);

      // Prepare the rows for the table
      const rows = cuentaData.movimientos.map(movimiento => [
        movimiento.fecha,
        movimiento.descripcion,
        movimiento.debito.toFixed(2),
        movimiento.credito.toFixed(2),
        movimiento.saldo.toFixed(2)
      ]);

      // Add a new table using the autotable plugin
      pdf.autoTable({
        startY: pdf.previousAutoTable ? pdf.previousAutoTable.finalY + 10 : 30,
        head: [['Fecha', 'Descripción', 'Débito', 'Crédito', 'Saldo']],
        body: rows,
        theme: 'striped',
        headStyles: { fillColor: [41, 128, 185] }, // Example styling
        margin: { top: 10 },
        styles: { fontSize: 10, cellPadding: 4 },
      });

      // Check if a new page is needed
      if (pdf.previousAutoTable.finalY > 260 && index < Object.entries(cuentas.value).length - 1) {
        pdf.addPage();
      }
    });

    // Save the PDF
    pdf.save('MayorGeneral.pdf');
    toast.add({ severity: 'success', summary: 'Éxito', detail: 'Archivo PDF generado con éxito.', life: 3000 });
  } catch (error) {
    console.error('Error exporting to PDF:', error);
    toast.add({ severity: 'error', summary: 'Error', detail: 'No se pudo generar el archivo PDF.', life: 3000 });
  }
};
/************************************************************************/
/************************************************************************/

/************************************************************************/
watch([fechaInicio, fechaFin, horaInicio, horaFin], async () => {

  await fetchAsientoDiario();
});
/************************************************************************/

</script>
<template>
<main class="content-wrapper">
  <div class="container-fluid mt-5">
           <div class="card flex justify-center gap-4">
            <InputGroup>
                 <Button label="Asiento Diario" as="router-link"  to="/asientodiario" raised icon="pi pi-book" severity="contrast"  />
                 <Button label="Exportar a Excel" raised @click="exportarExcel" icon="pi pi-file-excel" severity="success" class="ml-2"  />
                 <Button label="Exportar a PDF" raised @click="exportarPDF" icon="pi pi-file-pdf" severity="danger" class="ml-2"  />
               </InputGroup>
          </div>


    <Card class="mt-2">
      <template #content>
        <div class=" row">
          <div class="flex-auto col-12 col-md-3">
          <label for="calendar-12h" class="font-bold block mb-2">Fecha Inicio</label>
          <DatePicker 
            id="calendar-12h"
            showButtonBar
            dateFormat="yy-mm-dd"
            v-model="fechaInicio"
            showIcon
          />
          </div>
          <div class="flex-auto col-12 col-md-3">
          <label for="calendar-24h" class="font-bold block mb-2">Hora Inicio</label>
          <DatePicker
            id="calendar-24h"
            showIcon 
            iconDisplay="input" 
            timeOnly
            v-model="horaInicio" 
          />
          </div>
         <div class="flex-auto col-12 col-md-3">
          <label for="calendar-timeonly-start" class="font-bold block mb-2">Fecha Final</label>
          <DatePicker
            id="calendar-timeonly-start"
            showButtonBar
            dateFormat="yy-mm-dd"
            v-model="fechaFin"
            showIcon
          />
          </div>
          <div class="flex-auto col-12 col-md-3">
          <label for="calendar-timeonly-end" class="font-bold block mb-2">Hora Final</label>
          <DatePicker
            id="calendar-timeonly-end"
            dateFormat="hh:mm:ss"
            v-model="horaFin"
            showIcon 
            iconDisplay="input" 
            timeOnly
          />
          </div>
        </div>
      </template>
    </Card>


    <div class="row">
      <div class="col-md-12">
        <fieldset class="border p-3 rounded mb-2">
          <legend class="float-none w-auto px-2">Datos de Mayor General</legend>
            <div class="row">
              <!-- Iterar sobre las cuentas -->
              <div v-for="(cuenta, nombre) in cuentas" :key="nombre" class="col-md-12">
                <fieldset class="border p-3 rounded mb-2">
                  <legend class="float-none w-auto px-2">{{ nombre }}</legend>
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Débito</th>
                        <th>Crédito</th>
                        <th>Saldo</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr v-for="(movimiento, index) in cuenta.movimientos" :key="index">
                        <td>{{ movimiento.fecha }}</td>
                        <td>{{ movimiento.descripcion }}</td>
                        <td>{{ movimiento.debito.toFixed(2) }}</td>
                        <td>{{ movimiento.credito.toFixed(2) }}</td>
                        <td>{{ movimiento.saldo.toFixed(2) }}</td>
                      </tr>
                      <!-- Fila para mostrar el saldo total acumulado -->
                      <tr class="font-weight-bold">
                        <td colspan="4" class="text-right">Saldo Total:</td>
                        <td>{{ cuenta.saldo.toFixed(2) }}</td>
                      </tr>
                    </tbody>
                  </table>
                </fieldset>
              </div>

            </div>
        </fieldset>
      </div>
    </div>
  </div>
</main>
<LoadingOverlay :visible="loading" />
<Toast />
</template>

