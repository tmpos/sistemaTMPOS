const imprimirMicrosoldadura = async ()=>{
   var datosMicroSoldadura = await peticionesFetchOffline('getDataArrayByCondition', 'documentos','nombre','MICRO SOLDADURA');
   var logo = datosEmpresa.empresa.imagen
   var id = datoscampos.value.id;
   var cedula = datoscampos.value.cedula;
   var datosOrden = datoscampos.value;

   var equipo = '['+datosOrden.equipo+',- Marca:'+datosOrden.marca+',- Modelo:'+datosOrden.modelo+', - Serial:'+datosOrden.serial+']';

   var datosCliente = await peticionesFetchOffline('getDataArrayByCondition', 'clientes','cedula',cedula);

   const mensaje = variableEnString(datosMicroSoldadura[0].cuerpo, {'fecha':nfecha('fecha'),'cliente':datosCliente[0].nombre,'cedula':cedula,'direccion':datosCliente[0].direccion,'empresa':datosEmpresa.nombre,'equipo':equipo});
       // Crear una nueva ventana emergente
    const htmlContent = `
        <html>
        <head>
            <title>Contrato de Servicio</title>
            <style scoped>
                @page {
                    size: 80mm 297mm;
                    margin: 0;
                    }
                body {
                    font-family: 'Times New Roman', serif;
                    margin: 40px;
                    line-height: 1.4;
                    font-size: 14px;
                    text-align: justify; /* Texto justificado */
                }
                h1 {
                    text-align: center;
                    font-size: 20px;
                }
                pre {
                    white-space: pre-wrap;
                    word-wrap: break-word;
                }
                img {
                    display: block;
                    margin: 0 auto 20px auto; /* Centra la imagen y agrega un espacio antes del título */
                    width: 250px; /* O ajusta según el tamaño deseado */
                }
            </style>
        </head>
        <body>
            <img src="${logo}" alt="Logo de la Empresa">
            <h1>Contrato de Servicio de Micro Soldadura</h1>
            <pre>${mensaje}</pre>
        </body>
        </html>`;



window.electron.ipcRenderer.send('print-document', { html: htmlContent })

}
