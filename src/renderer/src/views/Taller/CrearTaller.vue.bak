/*  window.electron.ipcRenderer.invoke('open-new-window', link.value+'/vista/tallertermica?factura='+ultimoRegistro[0].no_factura,'url', true,false)*/

 const datosEmpresa = JSON.stringify(enviarDatosLocalStorage())
