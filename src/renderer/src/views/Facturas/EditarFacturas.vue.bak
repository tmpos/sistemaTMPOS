<a href="#" @click="visiblePrint = true" class="btn btn-dark text-white ms-1" ><i class="icon-print"></i></a>
<!-- <a href="#" @click="fnPrint" class="btn btn-warning text-white ms-1"><i class="icon-file-pdf"></i></a>
 -->
<a href="#" @click="fnSincronizarImei" v-if="datosDefault.modo == 'CELULAR'" class="btn btn-dark text-white ms-1"><i class="icon-mobile"></i></a>
<a href="#" @click="funcionActualizar"  class="btn btn-success text-white ms-1"><i class="icon-floppy"></i></a>



      </div>
    </div>
</fieldset>
