        <fieldset class="border p-3 rounded mb-2">
          <legend class="float-none w-auto px-2">Datos de Facturas</legend>
    <div class="row">
      <div class="col-sm-12">
       <router-link to="/facturas" class="btn btn-dark text-white "><i class="icon-home"></i></router-link>
<router-link to="/vender" class="btn btn-success text-white ms-1"><i class="icon-plus"></i></router-link>
