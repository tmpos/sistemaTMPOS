
<script setup>
import { ref, onMounted, nextTick, watchEffect } from 'vue';
import { useToast } from "primevue/usetoast";
import { useRouter, useRoute } from 'vue-router';
const router = useRouter();
const route = useRoute(); 
import {enviarDatosPorPost,
  eliminarDatos, 
  obtenerIdsSeleccionados,
  borrarTodoslosDatos,
  lenguajeDataTable,
  nfecha,
  arrayToObjetoFromTabla,
  peticionesFetch,
  encryptarPassword,
  envioElectron,
  generadorCodigo,
  generarCodigoUnico,
  peticiones,
  agregarDiasalaFechaActual,
  mensajetoast,
  lasMayusculas} from '../../funciones/funciones.js';
import Swal from 'sweetalert2'
const toast = useToast();
/************************************************************************/
import Awesomplete from '../../components/Awesomplete.vue';
/************************************************************************/
const listaEmpleados = ref([])
/************************************************************************/
import {useDatosEmpresa} from '../../stores'
const datosEmpresa = useDatosEmpresa();
const link = ref('');
const api = ref('');
const token = ref('');
const patronTelefono = ref('');
const linkImpresora = ref('');
const patroncedula = ref('');
const tokenCifrado = ref('');
const tokenCorto = ref('');
/************************************************************************/
const datoscamposNomina = ref({})
const codigoUnico = ref(generarCodigoUnico());
const fecha = ref(nfecha('fecha'));
const position = "top";
/************************************************************************/
const fetchAndSetupData = async () => {
    const jsonData = await arrayToObjetoFromTabla(link.value+api.value,tokenCifrado.value,'nomina');
    datoscamposNomina.value = jsonData;
};
/************************************************************************/

const fetchUsuarios = async () => {
  try {
    const response = await peticionesFetch(
      `${link.value}${api.value}`,
      'datosarraypost',
      { tabla: 'usuarios' },
      tokenCifrado.value,
      'POST'
    );
    //usuariosData.value = response;
    //usuariosDataNames.value = response.map(usuarios=>usuarios.name);
    for(let empleado of response){
      listaEmpleados.value.push(empleado)
    }
      console.log("listaEmpleados.value", listaEmpleados.value);
  } catch (error) {
    toast.add({ 
      severity: 'error', 
      summary: 'Error', 
      detail: 'Failed to fetch data from usuarios', 
      life: 3000 
    });
  }
};

/************************************************************************/
onMounted(async() => {
const datosJSON = await envioElectron('datosarchivo');
link.value = datosJSON.VITE_LINKURL;
api.value = datosJSON.VITE_LINK_API;
token.value = datosJSON.VITE_TOKEN;
patronTelefono.value = datosJSON.VITE_PATRON_TELEFONO;
linkImpresora.value = datosJSON.VITE_IMPRESORA_LOCAL;
patroncedula.value = datosJSON.VITE_PATRON_CEDULA;
tokenCifrado.value = await encryptarPassword(token.value, 10);

const ultimaNC = await peticiones(`${link.value}${api.value}/datosmax`, {"tabla":"nomina","campo":"no_nomina"},'POST',tokenCifrado.value);

await fetchAndSetupData()
await fetchUsuarios()
datoscamposNomina.value.no_nomina = generadorCodigo(ultimaNC[0], '', 8);
datoscamposNomina.value.estado = 'ACTIVA';
datoscamposNomina.value.fecha_inicio = nfecha('fecha');
datoscamposNomina.value.fecha_final = agregarDiasalaFechaActual(15);
datoscamposNomina.value.cargo = 'EMPLEADO';
datoscamposNomina.value.sueldo = '0.00';
datoscamposNomina.value.comision = '0.00';
datoscamposNomina.value.hora_extra = '0.00';
datoscamposNomina.value.ingreso_sdss = '0.00';
datoscamposNomina.value.sf_salud = '0.00';
datoscamposNomina.value.svejez_discap = '0.00';
datoscamposNomina.value.desc_percapita = '0.00';
datoscamposNomina.value.base_isr = '0.00';
datoscamposNomina.value.imp_sobre_renta = '0.00';
datoscamposNomina.value.prestamos = '0.00';
datoscamposNomina.value.avance_sueldo = '0.00';
datoscamposNomina.value.total_deducciones = '0.00';
datoscamposNomina.value.total_neto_pagar = '0.00';


});
/************************************************************************/
async function enviarDatos(event) {
    event.preventDefault();
  const url = link.value+api.value+"/insertar/nomina";
  if (!datoscamposNomina.value) {
    toast.add({ severity: 'error', summary: 'Error', detail: 'Datos incompletos, no se puede Enviar.', life: 3000 });
    return;
  }
  if (datoscamposNomina.value.hasOwnProperty('created_at')) {
     datoscamposNomina.value.created_at = nfecha('timestamp')
     datoscamposNomina.value.updated_at = nfecha('timestamp')
    }
  const envioDatos = await enviarDatosPorPost(url, datoscamposNomina.value,tokenCifrado.value);
  if (envioDatos[0] == 'ok') {
     toast.add({ severity: 'success', summary: 'Éxito', detail: 'Datos Agregados con éxito.', life: 3000 });
Swal.fire({
  title: "Datos Agregados",
  text: "Que hacemos ahora?",
  icon: "warning",
  showCancelButton: true,
  confirmButtonText: "Agregar Otro!",
  cancelButtonText: "No, Regresar al Inicio!",
 }).then(async(result) => {
  if (result.isConfirmed) {
      fetchAndSetupData()
} else if (result.dismiss === Swal.DismissReason.cancel) {
    router.push({ path: `/nomina` });
  }
})
  }else{
    toast.add({ severity: 'error', summary: 'Error', detail: 'Fallo al Agregar los datos.', life: 3000 });
  }
}
/************************************************************************/
const handleSelectComplete = ()=>{

}
/************************************************************************/
</script>
