<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="no_nomina" class="block text-sm font-medium text-gray-700 dark:text-gray-400">No nomina</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros readonly v-model="datoscamposNomina.no_nomina" placeholder="no_nomina" name="crearno_nomina" id="no_nomina" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="fecha_inicio" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha inicio</label>
                   <DatePicker  v-model="datoscamposNomina.fecha_inicio" dateFormat="dd/mm/yy" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="fecha_final" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Fecha final</label>
                   <DatePicker  v-model="datoscamposNomina.fecha_final" dateFormat="dd/mm/yy" showButtonBar fluid />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="estado" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Estado</label>

              <Dropdown v-model="datoscamposNomina.estado" :options="['ACTIVA','PAGADA','CANCELADA']" placeholder="Seleccione estado" class="w-full" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-4 xl:col-span-4 2xl:col-span-4">
                    <label for="cedula" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Cedula</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-model="datoscamposNomina.cedula" placeholder="cedula" name="crearcedula" id="cedula" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-6 xl:col-span-6 2xl:col-span-6">
                    <label for="nombre" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Nombre</label>
<!--                     <InputText type="text" class="form-input w-full "  v-mayuscula v-model="datoscamposNomina.nombre" placeholder="nombre" name="crearnombre" id="nombre" /> -->

               <Awesomplete
                    class="dropdown-input"
                    v-model="datoscamposNomina.nombre"
                    @selectComplete="handleSelectComplete"
                    :filter-field="'nombre'"
                    :list="listaEmpleados" />

                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="cargo" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Cargo</label>
                    <InputText type="text" class="form-input w-full "  v-mayuscula v-model="datoscamposNomina.cargo" placeholder="cargo" name="crearcargo" id="cargo" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="sueldo" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Sueldo</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.sueldo" placeholder="sueldo" name="crearsueldo" id="sueldo" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="comision" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Comision</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.comision" placeholder="comision" name="crearcomision" id="comision" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="hora_extra" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Hora extra</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.hora_extra" placeholder="hora_extra" name="crearhora_extra" id="hora_extra" />
                </div>

<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="ingreso_sdss" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Ingreso sdss</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.ingreso_sdss" placeholder="ingreso_sdss" name="crearingreso_sdss" id="ingreso_sdss" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="sf_salud" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Sf salud</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.sf_salud" placeholder="sf_salud" name="crearsf_salud" id="sf_salud" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
