    <div class="row">
      <div class="col-sm-12">
       <router-link to="/nomina" class="btn btn-dark text-white "><i class="icon-home"></i></router-link>
      </div>
    </div>
</fieldset>
<section>
<fieldset class="border p-3 rounded mb-2">
