<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="prestamos" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Prestamos</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.prestamos" placeholder="prestamos" name="crearprestamos" id="prestamos" />
