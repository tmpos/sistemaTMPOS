                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.desc_percapita" placeholder="desc_percapita" name="creardesc_percapita" id="desc_percapita" />
                </div>
<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                    <label for="base_isr" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Base isr</label>
                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.base_isr" placeholder="base_isr" name="crearbase_isr" id="base_isr" />
