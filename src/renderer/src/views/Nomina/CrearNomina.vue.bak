                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.imp_sobre_renta" placeholder="imp_sobre_renta" name="crearimp_sobre_renta" id="imp_sobre_renta" />
