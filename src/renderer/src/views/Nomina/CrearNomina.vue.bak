                    <InputText type="text" class="form-input w-full "  v-solonumeros v-decimales v-numeroFocusinOut v-model="datoscamposNomina.total_neto_pagar" placeholder="total_neto_pagar" name="creartotal_neto_pagar" id="total_neto_pagar" />
