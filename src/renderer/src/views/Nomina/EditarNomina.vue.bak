                <InputText type="text"  v-solonumeros v-decimales v-numeroFocusinOut class="form-input w-full " v-model="datoscampos.hora_extra" name="hora_extra" placeholder="hora_extra" id="actualizarhora_extra" />
            </div>

<div class="col-span-12 sm:col-span-12 md:col-span-6 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
                <label for="ingreso_sdss" class="block text-sm font-medium text-gray-700 dark:text-gray-400">Ingreso sdss</label>
                <InputText type="text"  v-solonumeros v-decimales v-numeroFocusinOut class="form-input w-full " v-model="datoscampos.ingreso_sdss" name="ingreso_sdss" placeholder="ingreso_sdss" id="actualizaringreso_sdss" />
