<input type="input" v-model="datoscampos.preciocompra" name="preciocompra"  class="form-control" id="preciocompra-Actualizador"  v-numeroFocusinOut v-decimales placeholder="preciocompra" v-solonumeros maxlength="250">
</div>
<div class="form-group col-12 col-sm-6 col-md-6 col-lg-6 col-xl-6" >
