                <label for="no_conduce" class="block text-sm font-medium text-gray-700 dark:text-gray-400">No conduce</label>
                <InputText type="text"  v-solonumeros readonly class="form-input w-full " v-model="datoscampos.no_conduce" name="no_conduce" placeholder="no_conduce" id="actualizarno_conduce" />
