                <InputText type="text"   readonly class="form-input w-full " v-model="datoscampos.cliente" name="cliente" placeholder="cliente" id="actualizarcliente" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-2 lg:col-span-2 xl:col-span-2 2xl:col-span-2">
