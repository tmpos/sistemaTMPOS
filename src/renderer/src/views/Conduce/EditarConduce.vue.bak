                <InputText type="text"  v-solonumeros class="form-input w-full " v-model="datoscampos.total" name="total" readonly placeholder="total" id="actualizartotal" />
            </div>
<div class="col-span-12 sm:col-span-12 md:col-span-12 lg:col-span-12 xl:col-span-12 2xl:col-span-12">
