  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.1",
    "@primevue/auto-import-resolver": "^4.0.1",
    "@rushstack/eslint-patch": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "autoprefixer": "^10.4.19",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "postcss": "^8.4.40",
    "prettier": "^3.2.5",
    "sass": "^1.55.0",
    "tailwindcss": "^3.4.6",
    "tailwindcss-primeui": "^0.3.2",
    "unplugin-vue-components": "^0.27.3",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.21.1",
    "vue": "^3.4.15"
  },
  "build": {
    "appId": "com.tmpos.tmpos",
    "productName": "TM-POS",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "resources/**/*",
      "out/**/*",
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/config.json",
        "to": "config.json"
      },
      {
        "from": "resources/database.db",
        "to": "database.db"
      },
      {
        "from": "resources/sounds",
        "to": "resources/sounds",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}.${ext}",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://actualizaciones.tmposrd.com/windows/"
      }
    ]
  }
}
