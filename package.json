    "vue-flatpickr-component": "^11.0.5",
    "vue-i18n": "^9.14.1",
    "vue-lazyload": "^3.0.0",
    "vue-loading-overlay": "6.0",
    "vue-router": "^4.4.0",
    "vue-social-chat": "^1.0.0",
    "vue-sweetalert2": "^5.0.11",
    "vue-to-print": "^1.3.1",
